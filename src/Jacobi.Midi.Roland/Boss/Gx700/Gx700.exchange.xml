<?xml version="1.0" encoding="utf-8"?>
<!--
  The message exchange of the Boss GX-700 (Roland one way: RQ1 is answered with DT1, DT1 is not acknowledged).
  The device needs 60 ms between two messages.
  See src/Jacobi.Midi.Device/Exchange/readme.md.
-->
<exchanges for="Gx700.AddressMap" responseTimeout="1000" messageInterval="60">
  <exchange name="requestData">
    <turn name="request">
      <send message="Roland.Message32.RQ1" />
      <receive message="Roland.Message32.DT1" />
    </turn>
  </exchange>
  <exchange name="sendData">
    <turn name="write">
      <send message="Roland.Message32.DT1" />
    </turn>
  </exchange>
  <exchange name="sendTemporary">
    <turn name="write">
      <send message="Roland.Message32.DT1" />
    </turn>
    <after>
      <send message="Gx700.SoundChangeRequest" />
    </after>
  </exchange>
</exchanges>
