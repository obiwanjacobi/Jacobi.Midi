<?xml version="1.0" encoding="utf-8"?>
<!--
  Roland GP-8 Guitar Effects Processor - memory map (Owner's Manual, MIDI Implementation v1.00).

  Used with the RolandType4 message schema: Model-ID 0x13, Device-ID = MIDI basic channel - 1.
  Only one parameter is sent/recognized per DT1 message; the Address selects the parameter.

  Address (2 x 7 bits, as sent):   MSB = 0 m g bbb nn     LSB = 0 n pppppp
    m       0 = temporary parameter, 1 = memory parameter
    g       group (0 = A, 1 = B)
    bbb     bank (0-7  = 1-8)
    nnn     number (0-7 = 1-8)     (2 high bits in the MSB, the low bit in the LSB)
    pppppp  parameter number (0x00-0x31), see the Patch group below
  Memory parameter 1 = group A, bank 1, number 1 ... memory parameter 128 = group B, bank 8, number 8.

  Legend:
    [OK]   available now
    [TODO] not available yet
-->
<schema name="Gp8" modelId="0x13">
  <includes>
    <include schema="midi" />
  </includes>
  <nodeDefs>
    <!-- GP-8 Model ID for reference -->
    <field name="GP8-ModelId" datatype="sys.uint8" value="0x13" />
  </nodeDefs>
  <dataTypeDefs>
    <dataTypeDef name="paramVal" basedOn="sys.uint8" min="0" max="100" />
    <dataTypeDef name="boolVal" basedOn="sys.bool" min="0" max="1" />
  </dataTypeDefs>
  <processorDefs>
    <processor name="bitBoolProc" processor="sys.bitpacker" bitLength="1" />
    <processor name="valBoolProc" processor="sys.map">
      <properties>
        <property name="to" value="sys.bool" />
        <property name="0" value="False" />
        <property name="1" value="True" />
      </properties>
    </processor>
  </processorDefs>

  <members>
    <!-- The 14-bit address as two 7-bit bytes plus its parts as virtual (peeked) fields.
         [TODO] On write the model must supply the virtual fields (they are not derived from the parts). -->
    <group name="Address">
      <processors>
        <processor name="sys.bytepacker" byteorder="big" />
      </processors>
      <members>
        <field name="Value" datatype="sys.uint16" byteLength="2" />

        <!-- peek back over both bytes as a 16-bit big endian value: bit 14 = m ... bit 0-5 = p -->
        <field name="Memory" datatype="sys.uint8" byteOffset="-2">
          <processor name="sys.bits" bitoffset="14" bitlength="1" />
        </field>
        <field name="Group" datatype="sys.uint8" byteOffset="-2">
          <processor name="sys.bits" bitoffset="13" bitlength="1" />
        </field>
        <field name="Bank" datatype="sys.uint8" byteOffset="-2">
          <processor name="sys.bits" bitoffset="10" bitlength="3" />
        </field>
        <!-- [TODO] Number is split over the MSB (2 high bits) and the LSB (low bit): needs a combine processor. -->
        <field name="NumberHigh" datatype="sys.uint8" byteOffset="-2">
          <processor name="sys.bits" bitoffset="8" bitlength="2" />
        </field>
        <field name="NumberLow" datatype="sys.uint8" byteOffset="-2">
          <processor name="sys.bits" bitoffset="6" bitlength="1" />
        </field>
        <field name="Parameter" datatype="sys.uint8" byteOffset="-2">
          <processor name="sys.bits" bitoffset="0" bitlength="6" />
        </field>
      </members>
    </group>

    <group name="AddressMap" byteSize="0x32" nodeDef="roland.messageBody">
      <members>

        <!-- One patch: the parameters in address order 0x00 - 0x31. Each is one 7-bit byte unless noted. -->
        <!-- [TODO] The same layout applies to the 128 memory parameters (repeat count=128); needs group reuse (typedef with members). -->
        <repeat name="Patch" byteSize="0x32" >
          <processors>
            <processor name="sys.bytepacker" byteorder="big" />
          </processors>
          <members>
            <!-- 0x00: effect on/off (MSB) -->
            <group name="EffectSwiches1" byteLength="1">
              <processors>
                <processor name="sys.bitpacker" />
              </processors>
              <members>
                <field name="PhaserOn" datatype="boolVal" bits="1"/>
                <field name="EqualizerOn" datatype="boolVal" bits="1"/>
                <field name="DelayOn" datatype="boolVal" bits="1"/>
                <field name="ChorusOn" datatype="boolVal" bits="1"/>
              </members>
            </group>

            <!-- 0x01: effect on/off (LSB) -->
            <group name="EffectSwiches2" byteLength="1">
              <processors>
                <processor name="sys.bitpacker" />
              </processors>
              <members>
                <field name="DynamicFilterOn" datatype="boolVal" bits="1"/>
                <field name="CompressorOn" datatype="boolVal" bits="1"/>
                <field name="TurboOverdriveOn" datatype="boolVal" bits="1"/>
                <field name="DistortionOn" datatype="boolVal" bits="1"/>
              </members>
            </group>

            <group name="DynamicFilter">
              <members>
                <field name="Sens" datatype="paramVal" />
                <!-- 0x02: 0-100 -->
                <field name="CutoffFreq" datatype="paramVal" />
                <!-- 0x03: 0-100 -->
                <field name="Q" datatype="paramVal" />
                <!-- 0x04: 0-100 -->
                <field name="UpDown" datatype="sys.uint8" />
                <!-- 0x05: 0 = down, 100 = up -->
              </members>
            </group>
            <group name="Compressor">
              <members>
                <field name="Attack" datatype="paramVal" />
                <!-- 0x06: 0-100 -->
                <field name="Sustain" datatype="paramVal" />
                <!-- 0x07: 0-100 -->
              </members>
            </group>
            <group name="TurboOverdrive">
              <members>
                <field name="Tone" datatype="paramVal" />
                <!-- 0x08: 0-100 -->
                <field name="Drive" datatype="paramVal" />
                <!-- 0x09: 0-100 -->
                <field name="Turbo" datatype="sys.bool" />
                <!-- 0x0A: 0 = off, 1 = on -->
              </members>
            </group>
            <group name="Distortion">
              <members>
                <field name="Tone" datatype="paramVal" />
                <!-- 0x0B: 0-100 -->
                <field name="Dist" datatype="paramVal" />
                <!-- 0x0C: 0-100 -->
              </members>
            </group>
            <group name="Phaser">
              <members>
                <field name="Rate" datatype="paramVal" />
                <!-- 0x0D: 0-100 -->
                <field name="Depth" datatype="paramVal" />
                <!-- 0x0E: 0-100 -->
                <field name="Resonance" datatype="paramVal" />
                <!-- 0x0F: 0-100 -->
              </members>
            </group>
            <group name="Equalizer">
              <members>
                <field name="HiLevel" datatype="paramVal" />
                <!-- 0x10: 0-100 -->
                <field name="MidLevel" datatype="paramVal" />
                <!-- 0x11: 0-100 -->
                <field name="LoLevel" datatype="paramVal" />
                <!-- 0x12: 0-100 -->
                <field name="OutLevel" datatype="paramVal" />
                <!-- 0x13: 0-100 -->
              </members>
            </group>
            <group name="DigitalDelay">
              <members>
                <field name="ELevel" datatype="paramVal" />
                <!-- 0x14: 0-100 -->
                <!-- 0x15 (MSB), 0x16 (LSB): 0-1000 -->
                <field name="DTime" datatype="sys.uint16" byteLength="2">
                  <processor name="sys.bitslicer" bits="7" byteorder="big" />
                </field>
                <field name="Feedback" datatype="paramVal" />
                <!-- 0x17: 0-100 -->
              </members>
            </group>
            <group name="DigitalChorus">
              <members>
                <field name="Rate" datatype="paramVal" />
                <!-- 0x18: 0-100 -->
                <field name="Depth" datatype="paramVal" />
                <!-- 0x19: 0-100 -->
                <field name="ELevel" datatype="paramVal" />
                <!-- 0x1A: 0-100 -->
                <field name="PreDelay" datatype="paramVal" />
                <!-- 0x1B: 0-100 -->
                <field name="Feedback" datatype="paramVal" />
                <!-- 0x1C: 0-100 -->
              </members>
            </group>

            <field name="MasterVolume" datatype="paramVal" />
            <!-- 0x1D: 0-100 -->
            <field name="Ev5Parameter" datatype="sys.uint8" />
            <!-- 0x1E: 0 = off, 1-27 (parameter of turned-on effect)-->
            <field name="ExtControlOut1" datatype="paramVal" />
            <!-- 0x1F: 0 = off, 100 = on -->
            <field name="ExtControlOut2" datatype="paramVal" />
            <!-- 0x20: 0 = off, 100 = on -->
            <field name="Name" datatype="sys.string" byteLength="16">
              <processor name="ref:midi.string" />
            </field>
            <!-- 0x21-0x30: ASCII 32-127 -->
            <field name="EndOfString" datatype="sys.uint8" value="0" />
            <!-- 0x31 -->
          </members>
        </repeat>

      </members>
    </group>

  </members>
</schema>
