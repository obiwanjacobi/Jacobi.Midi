<?xml version="1.0" encoding="utf-8"?>
<!--
  Boss GX-700 Guitar Effects Processor - memory map.

  Derived from the boss-gx-700-patch-parser by Tom Weatherhead
  (https://github.com/tom-weatherhead/boss-gx-700-patch-parser, src/script.js) and checked against the bulk dumps
  in Jacobi.Midi.Tests/Schema (gx700-sysex-patch1.syx, gx700-sysex-system.syx). There is no manual source yet.

  Used with the Message32 messages of the Roland schema (4 address bytes): Model-ID 0x79, Device-ID 0x00 in the dumps.

    F0 41 <dev> 79 12 <address:4> data <checksum> F7

  Address (4 x 7 bits, as sent):   aa pp ss 00
    aa   area: 00 = patches, 02 = system
    pp   patch number 0x00-0x63 (patch 1-100), 00 in the system area
    ss   section: one DT1 per section; the patch has 14 sections (header and 13 effects), the system 3
  A section is transferred as a whole (one DT1 in the bulk dump), so the sections are atomic. Each section occupies
  0x01-00 addresses (128), a patch 0x01-00-00.

  Values are one 7-bit byte unless noted. Some values are stored with an offset; the comment gives the stored range
  and (=) the displayed value. Two kinds of 2 byte values are used:
    nibble8  4 + 4 bits (MSB first): 0F 0F = 0xFF. Tempo, Resonance, Separation; the Program Change map.
    sysex14  7 + 7 bits (MSB first): Delay Time.
  Enumerations are dataTypeDefs with options that map the stored values to the names used by the parser. Lists that recur:
    hiCut     0-15: 500 Hz, 630, 800, 1.00 kHz, 1.25k, 1.60k, 2.00k, 2.50k, 3.15k, 4.00k, 5.00k, 6.30k, 8.00k, 10.0k, 12.5k, Flat
    lowCut    0-10: Flat, 55 Hz, 110, 165, 220, 280, 340, 400, 500, 630, 800
    midiCc    MIDI CC#1-31, then CC#64-95 (63 entries), at the end of wahPedal, pedal and tempoIn

  The midi.* properties describe the address map (see src/Jacobi.Midi.Device/Addressing/readme.md).
-->
<schema name="Gx700">
  <includes>
    <include schema="midi" />
    <include schema="roland" />
  </includes>
  <nodeDefs>
    <!-- 8 bits in 2 bytes of 4 bits each (MSB first). -->
    <field name="nibble8" datatype="sys.uint8" byteLength="2">
      <processor name="sys.bitslicer" bits="4" byteorder="big" />
    </field>
    <!-- 14 bits in 2 bytes of 7 bits each (MSB first). -->
    <field name="sysex14" datatype="sys.uint16" byteLength="2">
      <processor name="midi.sysexbyte" />
    </field>

    <!-- One patch: 14 sections, one DT1 each. The offsets are relative to the start of the section. -->
    <group name="patch">
      <members>
        <!-- Section 00: 66 bytes. -->
        <group name="Common" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: [TODO] 0x4E in the dump (patch level?) -->
            <field name="Unknown00" datatype="sys.uint8" />
            <!-- 0x01-0x0D: 1-13. [TODO] verify: 01-0D in the dump; most likely the effect chain order (section numbers 1-13). -->
            <repeat name="EffectOrder" count="13">
              <members>
                <field name="Section" datatype="sys.uint8" />
              </members>
            </repeat>
            <!-- 0x0E-0x19: ASCII -->
            <field name="Name" datatype="sys.string" byteLength="12">
              <processor name="midi.string" />
            </field>
            <!-- 0x1A-0x41: [TODO] 4 blocks of 10 bytes, e.g. 03 07 00 00 00 64 00 00 00 7F (control assignments?). -->
            <field name="Unknown1A" datatype="sys.bytes" byteLength="40" />
          </members>
        </group>

        <!-- Section 01: 8 bytes. -->
        <group name="Compressor" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0 = compressor, 1 = limiter -->
            <field name="Type" datatype="compressorType" />
            <!-- 0x02: 0-100 (compressor) -->
            <field name="Sustain" datatype="roland.level" />
            <!-- 0x03: 0-100 (compressor) -->
            <field name="Attack" datatype="roland.level" />
            <!-- 0x04: 0-100 (limiter) -->
            <field name="Threshold" datatype="roland.level" />
            <!-- 0x05: 0-100 (limiter) -->
            <field name="Release" datatype="roland.level" />
            <!-- 0x06: 0-100 (= -50 - +50) -->
            <field name="Tone" datatype="int50" />
            <!-- 0x07: 0-100 -->
            <field name="EffectLevel" datatype="roland.level" />
          </members>
        </group>

        <!-- Section 02: 13 bytes. -->
        <group name="Wah" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0 = pedal wah, 1 = sw-pedal wah, 2 = auto wah -->
            <field name="Mode" datatype="wahMode" />
            <!-- 0x02: 0-100 (pedal) -->
            <field name="Frequency" datatype="roland.level" />
            <!-- 0x03: 0 = down, 1 = up (auto) -->
            <field name="Polarity" datatype="polarity" />
            <!-- 0x04: 0-100 (auto) -->
            <field name="Sensitivity" datatype="roland.level" />
            <!-- 0x05: 0-100 (auto) -->
            <field name="Manual" datatype="roland.level" />
            <!-- 0x06: 0-100 -->
            <field name="Peak" datatype="roland.level" />
            <!-- 0x07: 0 = fixed, 1 = EXP pedal, 2 = FC-200EXP, 3-65 = midiCc (pedal) -->
            <field name="Pedal" datatype="wahPedal" />
            <!-- 0x08: 0-100 (pedal) -->
            <field name="PedalMin" datatype="roland.level" />
            <!-- 0x09: 0-100 (pedal) -->
            <field name="PedalMax" datatype="roland.level" />
            <!-- 0x0A: 0-100 (auto) -->
            <field name="Rate" datatype="roland.level" />
            <!-- 0x0B: 0-100 (auto) -->
            <field name="Depth" datatype="roland.level" />
            <!-- 0x0C: 0-100 -->
            <field name="EffectLevel" datatype="roland.level" />
          </members>
        </group>

        <!-- Section 03: 6 bytes. -->
        <group name="OverdriveDistortion" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0 = Vintage OD, 1 = Turbo OD, 2 = Blues, 3 = Distortion, 4 = Turbo DS, 5 = Metal, 6 = Fuzz -->
            <field name="Type" datatype="distortionType" />
            <!-- 0x02: 0-100 -->
            <field name="Drive" datatype="roland.level" />
            <!-- 0x03: 0-100 (= -50 - +50) -->
            <field name="Bass" datatype="int50" />
            <!-- 0x04: 0-100 (= -50 - +50) -->
            <field name="Treble" datatype="int50" />
            <!-- 0x05: 0-100 -->
            <field name="EffectLevel" datatype="roland.level" />
          </members>
        </group>

        <!-- Section 04: 10 bytes. -->
        <group name="Preamp" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0 = JC-120, 1 = Clean Twin, 2 = Match Drive, 3 = BG Lead, 4 = MS1959 (I), 5 = MS1959 (II),
                 6 = MS1959 (I+II), 7 = SLDN Lead, 8 = Metal 5150 -->
            <field name="Type" datatype="preampType" />
            <!-- 0x02: 0-100 -->
            <field name="Volume" datatype="roland.level" />
            <!-- 0x03: 0-100 -->
            <field name="Bass" datatype="roland.level" />
            <!-- 0x04: 0-100 -->
            <field name="Middle" datatype="roland.level" />
            <!-- 0x05: 0-100 -->
            <field name="Treble" datatype="roland.level" />
            <!-- 0x06: 0-100 -->
            <field name="Presence" datatype="roland.level" />
            <!-- 0x07: 0-100 -->
            <field name="Master" datatype="roland.level" />
            <!-- 0x08: 0 = off, 1 = on (JC-120, Clean Twin, BG Lead) -->
            <field name="Bright" datatype="roland.switch" />
            <!-- 0x09: 0 = low, 1 = middle, 2 = high -->
            <field name="Gain" datatype="preampGain" />
          </members>
        </group>

        <!-- Section 05: 4 bytes. -->
        <group name="Loop" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0-100 % -->
            <field name="ReturnLevel" datatype="roland.level" />
            <!-- 0x02: 0-100 % -->
            <field name="SendLevel" datatype="roland.level" />
            <!-- 0x03: 0 = series, 1 = parallel -->
            <field name="Mode" datatype="loopMode" />
          </members>
        </group>

        <!-- Section 06: 7 bytes. -->
        <group name="Equalizer" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0-40 (= -20 - +20 dB) -->
            <field name="LowGain" datatype="int20" />
            <!-- 0x02: 0-20 (= 100 Hz, 125, 160, 200, 250, 315, 400, 500, 630, 800, 1.00 kHz, 1.25k, 1.60k, 2.00k, 2.50k,
                 3.15k, 4.00k, 5.00k, 6.30k, 8.00k, 10.0k) -->
            <field name="MiddleFrequency" datatype="eqMiddleFrequency" />
            <!-- 0x03: 0-40 (= -20 - +20 dB) -->
            <field name="MiddleGain" datatype="int20" />
            <!-- 0x04: 0-5 (= 0.5, 1, 2, 4, 8, 16) -->
            <field name="MiddleQ" datatype="eqMiddleQ" />
            <!-- 0x05: 0-40 (= -20 - +20 dB) -->
            <field name="HighGain" datatype="int20" />
            <!-- 0x06: 0-40 (= -20 - +20 dB) -->
            <field name="Level" datatype="int20" />
          </members>
        </group>

        <!-- Section 07: 5 bytes. -->
        <group name="SpeakerSimulator" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0 = Small, 1 = Middle, 2 = JC-120, 3-6 = Built-In 1-4, 7-8 = BG Stack 1-2, 9-10 = MS Stack 1-2,
                 11 = Metal Stack -->
            <field name="Type" datatype="speakerType" />
            <!-- 0x02: 1-10 (as read by the parser) -->
            <field name="MicSetting" datatype="sys.uint8" />
            <!-- 0x03: 0-100 -->
            <field name="MicLevel" datatype="roland.level" />
            <!-- 0x04: 0-100 -->
            <field name="DirectLevel" datatype="roland.level" />
          </members>
        </group>

        <!-- Section 08: 5 bytes. -->
        <group name="NoiseSuppressor" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0-100 -->
            <field name="Threshold" datatype="roland.level" />
            <!-- 0x02: 0-100 -->
            <field name="Release" datatype="roland.level" />
            <!-- 0x03: 0 = guitar in, 1 = NS in -->
            <field name="Detect" datatype="nsDetect" />
            <!-- 0x04: 0-100 -->
            <field name="EffectLevel" datatype="roland.level" />
          </members>
        </group>

        <!-- Section 09: 77 bytes. Which parameters apply depends on the mode (in parentheses). -->
        <group name="Modulation" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0 = Flanger, 1 = Phaser, 2 = Pitch Shifter, 3 = Harmonist, 4 = Vibrato, 5 = Ring Modulator,
                 6 = Humanizer -->
            <field name="Mode" datatype="modulationMode" />
            <!-- 0x02: 0-4 (= 4, 6, 8, 10, 12 stage) (phaser) -->
            <field name="PhaserType" datatype="phaserType" />
            <!-- 0x03: 0 = off, 1 = on, 2 = auto (vibrato) -->
            <field name="VibratoTrigger" datatype="vibratoTrigger" />
            <!-- 0x04: 0-100 (vibrato) -->
            <field name="VibratoRiseTime" datatype="roland.level" />
            <!-- 0x05: 0 = auto, 1 = pedal (humanizer) -->
            <field name="HumanizerMode" datatype="humanizerMode" />
            <!-- 0x06: 0-4 (= a, e, i, o, u) (humanizer) -->
            <field name="HumanizerVowel1" datatype="vowel" />
            <!-- 0x07: 0-4 (= a, e, i, o, u) (humanizer) -->
            <field name="HumanizerVowel2" datatype="vowel" />
            <!-- 0x08: 0-100 (flanger, phaser, vibrato, humanizer auto) -->
            <field name="Rate" datatype="roland.level" />
            <!-- 0x09: 0-100 (flanger, phaser, vibrato, humanizer auto) -->
            <field name="Depth" datatype="roland.level" />
            <!-- 0x0A: 0-100 (flanger, phaser) -->
            <field name="Manual" datatype="roland.level" />
            <!-- 0x0B (MSB), 0x0C (LSB): 0-200 (= -100 - +100) (flanger, phaser) -->
            <field name="Resonance" nodeDef="nibble8" datatype="int100" />
            <!-- 0x0D: 0 = off, 1-100 (phaser) -->
            <field name="PhaserStep" datatype="roland.level" />
            <!-- 0x0E (MSB), 0x0F (LSB): 0-200 (= -100 - +100) (flanger) -->
            <field name="FlangerSeparation" nodeDef="nibble8" datatype="int100" />
            <!-- 0x10: 0 = off, 1-100 (flanger) -->
            <field name="FlangerGate" datatype="roland.level" />
            <!-- 0x11: 0 = off, 1 = auto (humanizer auto) -->
            <field name="HumanizerTrigger" datatype="humanizerTrigger" />
            <!-- 0x12: 0 = EXP pedal, 1 = FC-200EXP, 2-64 = midiCc (humanizer pedal) -->
            <field name="HumanizerPedal" datatype="pedal" />
            <!-- 0x13: 0 = intelligent, 1-100 (ring modulator) -->
            <field name="RingModFrequency" datatype="roland.level" />
            <!-- 0x14: 0-100 (ring modulator) -->
            <field name="RingModEffectLevel" datatype="roland.level" />
            <!-- 0x15: 0-100 (ring modulator) -->
            <field name="RingModDirectLevel" datatype="roland.level" />
            <!-- 0x16: 0 = slow, 1 = fast, 2 = mono (pitch shifter) -->
            <field name="PitchShifterMode" datatype="pitchShifterMode" />
            <!-- 0x17: 0-48 (= -24 - +24 semitones) (pitch shifter) -->
            <field name="Pitch1" datatype="int24" />
            <!-- 0x18: 0-48 (= -24 - +24 semitones) (pitch shifter) -->
            <field name="Pitch2" datatype="int24" />
            <!-- 0x19: 0-48 (= -24 - +24 semitones) (pitch shifter) -->
            <field name="Pitch3" datatype="int24" />
            <!-- 0x1A: 0-100 (= -50 - +50) (pitch shifter) -->
            <field name="Fine1" datatype="int50" />
            <!-- 0x1B: 0-100 (= -50 - +50) (pitch shifter) -->
            <field name="Fine2" datatype="int50" />
            <!-- 0x1C: 0-100 (= -50 - +50) (pitch shifter) -->
            <field name="Fine3" datatype="int50" />
            <!-- 0x1D: 0-11 = C, Db, D, Eb, E, F, F#, G, Ab, A, Bb, B major; 12-23 = A, Bb, B, C, C#, D, D#, E, F, F#, G,
                 G# minor (harmonist) -->
            <field name="HarmonistKey" datatype="harmonistKey" />
            <!-- 0x1E: 0-28 (= -2 octaves - +2 octaves in diatonic steps, 14 = unison) (harmonist) -->
            <field name="HarmonistInterval1" datatype="harmonistInterval" />
            <!-- 0x1F: 0-28 (= -2 octaves - +2 octaves in diatonic steps, 14 = unison) (harmonist) -->
            <field name="HarmonistInterval2" datatype="harmonistInterval" />
            <!-- 0x20: 0-28 (= -2 octaves - +2 octaves in diatonic steps, 14 = unison) (harmonist) -->
            <field name="HarmonistInterval3" datatype="harmonistInterval" />
            <!-- 0x21: 0-100 (= L100:0R - L0:100R) (pitch shifter, harmonist) -->
            <field name="Pan1" datatype="roland.level" />
            <!-- 0x22: 0-100 (= L100:0R - L0:100R) (pitch shifter, harmonist) -->
            <field name="Pan2" datatype="roland.level" />
            <!-- 0x23: 0-100 (= L100:0R - L0:100R) (pitch shifter, harmonist) -->
            <field name="Pan3" datatype="roland.level" />
            <!-- 0x24: 0-100 (pitch shifter, harmonist) -->
            <field name="Level1" datatype="roland.level" />
            <!-- 0x25: 0-100 (pitch shifter, harmonist) -->
            <field name="Level2" datatype="roland.level" />
            <!-- 0x26: 0-100 (pitch shifter, harmonist) -->
            <field name="Level3" datatype="roland.level" />
            <!-- 0x27: 0-100 (= D100:0E - D0:100E) (pitch shifter, harmonist) -->
            <field name="Balance" datatype="roland.level" />
            <!-- 0x28: 0-100 (pitch shifter, harmonist) -->
            <field name="TotalLevel" datatype="roland.level" />
            <!-- 0x29-0x4C: [TODO] 12 x 3 bytes, e.g. 1C 13 24 1B 12 24 ... (harmonist user scale: 12 notes x 3 voices?). -->
            <field name="Unknown29" datatype="sys.bytes" byteLength="36" />
          </members>
        </group>

        <!-- Section 0A: 21 bytes. -->
        <group name="Delay" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0 = normal, 1 = tempo -->
            <field name="Mode" datatype="delayMode" />
            <!-- 0x02: 0 = fixed, 1 = control 1, 2 = control 2, 3 = FC-200CTL, 4-66 = midiCc (tempo) -->
            <field name="TempoIn" datatype="tempoIn" />
            <!-- 0x03 (MSB), 0x04 (LSB): 0-250 (= 50-300 BPM) (tempo, tempo in fixed) -->
            <field name="Tempo" nodeDef="nibble8" datatype="uint50_300"/>
            <!-- 0x05 (MSB), 0x06 (LSB): 1-2000 ms (normal) -->
            <field name="TimeCenter" nodeDef="sysex14" datatype="uint2000"/>
            <!-- 0x07 (MSB), 0x08 (LSB): 1-400 % of the center.
                 [TODO] verify: the parser reads MSB x 256 + LSB, which cannot reach 400 with 7-bit bytes; 7 + 7 bits is assumed. -->
            <field name="TimeLeft" nodeDef="sysex14" datatype="uint1_400" />
            <!-- 0x09 (MSB), 0x0A (LSB): 1-400 % of the center -->
            <field name="TimeRight" nodeDef="sysex14" datatype="uint1_400"/>
            <!-- 0x0B: 0-10 (= 1/4, 1/3, 3/8, 1/2, 2/3, 3/4, 1.0, 1.5, 2.0, 3.0, 4.0) (tempo) -->
            <field name="IntervalCenter" datatype="delayInterval" />
            <!-- 0x0C: 0-100 -->
            <field name="Feedback" datatype="roland.level" />
            <!-- 0x0D: 0-100 -->
            <field name="LevelCenter" datatype="roland.level" />
            <!-- 0x0E: 0-100 -->
            <field name="LevelLeft" datatype="roland.level" />
            <!-- 0x0F: 0-100 -->
            <field name="LevelRight" datatype="roland.level" />
            <!-- 0x10: 0-50 (= -50 - 0) -->
            <field name="HighDamp" datatype="shiftDown50" />
            <!-- 0x11: 0-15 = hiCut -->
            <field name="HighCut" datatype="hiCut" />
            <!-- 0x12: 0 = off, 1 = on -->
            <field name="Smooth" datatype="roland.switch" />
            <!-- 0x13: 0-100 -->
            <field name="EffectLevel" datatype="roland.level" />
            <!-- 0x14: 0-100 -->
            <field name="DirectLevel" datatype="roland.level" />
          </members>
        </group>

        <!-- Section 0B: 9 bytes. -->
        <group name="Chorus" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0 = mono, 1 = stereo -->
            <field name="Mode" datatype="chorusMode" />
            <!-- 0x02: 0-100 -->
            <field name="Rate" datatype="roland.level" />
            <!-- 0x03: 0-100 -->
            <field name="Depth" datatype="roland.level" />
            <!-- 0x04: x 0.5 ms -->
            <field name="PreDelay" datatype="halves0_50" />
            <!-- 0x05: 0-10 = lowCut -->
            <field name="LowCut" datatype="lowCut" />
            <!-- 0x06: 0-15 = hiCut -->
            <field name="HighCut" datatype="hiCut" />
            <!-- 0x07: 0-10 [TODO] (= tri 10:0 sin - tri 0:10 sin) -->
            <field name="Lfo" datatype="sys.uint8" />
            <!-- 0x08: 0-100 -->
            <field name="EffectLevel" datatype="roland.level" />
          </members>
        </group>

        <!-- Section 0C: 5 bytes. -->
        <group name="TremoloPan" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0 = tremolo triangle, 1 = tremolo square, 2 = pan triangle, 3 = pan square -->
            <field name="Mode" datatype="tremoloPanMode" />
            <!-- 0x02: 0-100 -->
            <field name="Rate" datatype="roland.level" />
            <!-- 0x03: 0-100 -->
            <field name="Depth" datatype="roland.level" />
            <!-- 0x04: 0-100 (= L100:0R - L0:100R) -->
            <field name="Balance" datatype="roland.level" />
          </members>
        </group>

        <!-- Section 0D: 9 bytes. -->
        <group name="Reverb" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00: 0 = off, 1 = on -->
            <field name="On" datatype="roland.switch" />
            <!-- 0x01: 0-4 (= Room1, Room2, Hall1, Hall2, Plate) -->
            <field name="Type" datatype="reverbType" />
            <!-- 0x02: 1-100 (= 0.1 - 10 s) -->
            <field name="Time" datatype="tenths01_100" />
            <!-- 0x03: 0-100 ms -->
            <field name="PreDelay" datatype="roland.level" />
            <!-- 0x04: 0-10 = lowCut -->
            <field name="LowCut" datatype="lowCut" />
            <!-- 0x05: 0-15 = hiCut -->
            <field name="HighCut" datatype="hiCut" />
            <!-- 0x06: 0-10 -->
            <field name="Diffusion" datatype="uint10" />
            <!-- 0x07: 0-100 -->
            <field name="EffectLevel" datatype="roland.level" />
            <!-- 0x08: 0-100 -->
            <field name="DirectLevel" datatype="roland.level" />
          </members>
        </group>
      </members>
    </group>

    <!--
      The system: 3 sections, one DT1 each. Not described by the parser: the layout is taken from the dump only.
      [TODO] name the system parameters.
    -->
    <group name="system">
      <members>
        <!-- Section 00: 19 bytes. -->
        <group name="Common" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <!-- 0x00-0x12: [TODO] e.g. 05 01 00 00 00 14 06 04 04 04 00 01 0C 08 00 00 0F 00 01 in the dump. -->
            <field name="Unknown00" datatype="sys.bytes" byteLength="19" />
          </members>
        </group>
        <!--
          Sections 01 and 02: 128 bytes each, 64 values of nibble8, 1-128 in order in the dump.
          [TODO] verify: most likely the Program Change map (program 1-64 and 65-128 to a patch).
        -->
        <group name="ProgramChangeMap1" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <repeat name="Program" count="64">
              <members>
                <field name="Patch" nodeDef="nibble8" />
              </members>
            </repeat>
          </members>
        </group>
        <group name="ProgramChangeMap2" midi.atomic="true" midi.stride="0x01-00">
          <members>
            <repeat name="Program" count="64">
              <members>
                <field name="Patch" nodeDef="nibble8" />
              </members>
            </repeat>
          </members>
        </group>
      </members>
    </group>
  </nodeDefs>

