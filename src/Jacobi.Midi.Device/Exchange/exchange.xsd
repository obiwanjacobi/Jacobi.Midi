<?xml version="1.0" encoding="utf-8"?>
<!--
  The XML format of an exchange file: the message exchange patterns of one map root (see readme.md).
  An exchange file can refer to it with xsi:noNamespaceSchemaLocation.

  Rules the reader checks that XSD 1.0 cannot express:
  - a turn has at most one <send>;
  - an <on> has either an 'event' or a 'message', and either a 'goto' or a 'result';
  - 'goto' names a turn of the same part (the turns per block, <before> or <after>); every turn can be reached from
    the first one of its part;
  - the turns of <before> and <after> have no <receive>, and their messages carry no data (checked when used);
  - 'sent' needs a <send> in the turn, 'received' a <receive>;
  - 'retry' is only for 'timeout' and messages, not for 'sent' or 'received';
  - names of exchanges (in the file) and of turns (in a part of an exchange) are unique, ignoring case.
  The reader accepts the event and result values in any case; the values below are the canonical spelling.

  Defaults, for a turn without an <on> for the event:
  - 'received' (a turn with a <receive>): result 'completed';
  - 'sent' (a turn with a <send> that waits for nothing: no <receive> and no <on>): result 'completed';
  - 'timeout': result 'timedOut'.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

  <xs:element name="exchanges">
    <xs:annotation>
      <xs:documentation>The exchanges of one map root, with the timing of the device.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="exchange" type="exchange" maxOccurs="unbounded" />
      </xs:sequence>
      <xs:attribute name="for" type="schemaName" use="required">
        <xs:annotation>
          <xs:documentation>The schema name of the map root whose ranges these exchanges transfer, e.g. 'Gx700.AddressMap'.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attributeGroup ref="timing" />
    </xs:complexType>
  </xs:element>

  <xs:attributeGroup name="timing">
    <xs:attribute name="responseTimeout" type="xs:nonNegativeInteger">
      <xs:annotation>
        <xs:documentation>Milliseconds a turn waits for an event; default 1000 (an exchange takes the file's value).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="messageInterval" type="xs:nonNegativeInteger">
      <xs:annotation>
        <xs:documentation>The least number of milliseconds between two messages sent to the device; default 0 (an exchange takes the file's value).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:complexType name="exchange">
    <xs:annotation>
      <xs:documentation>One exchange: a state machine of turns that runs once per block of the range; the first turn is the start. Optional turns run once per call, before and after the blocks.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="before" type="part" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Turns that run once per call, before the blocks (e.g. a bulk header); when they do not complete, no block is transferred.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="turn" type="turn" maxOccurs="unbounded" />
      <xs:element name="after" type="part" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Turns that run once per call, after the blocks, only when all blocks completed (e.g. a store request or a bulk footer).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>A standard name (requestData, sendData) or a name of the file's own.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="timing" />
  </xs:complexType>

  <xs:complexType name="part">
    <xs:annotation>
      <xs:documentation>Turns once per call: their messages are built for the whole range (address: its start, size: its size) and carry no data; they receive no data. The first turn is the start; a 'goto' stays in the part.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="turn" type="turn" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="turn">
    <xs:annotation>
      <xs:documentation>A turn in the conversation with the device: on entry it sends its message (if any), then waits for the events it has an 'on' for (or a default: see above).</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="send" type="message">
        <xs:annotation>
          <xs:documentation>The message to build for the block and send on entry (at most one).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="receive" type="message">
        <xs:annotation>
          <xs:documentation>A data message whose data is accepted for the block while in the turn, and counts towards 'received'.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="on" type="transition" />
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="message">
    <xs:attribute name="message" type="messageName" use="required" />
  </xs:complexType>

  <xs:complexType name="transition">
    <xs:annotation>
      <xs:documentation>On the event or message: enter the turn again while retries are left, then go to a turn, or end the run for the block with a result. The first 'on' that matches is taken.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="event" type="event" />
    <xs:attribute name="message" type="messageName" />
    <xs:attribute name="retry" type="xs:positiveInteger">
      <xs:annotation>
        <xs:documentation>The most times the turn is entered again (its message sent again) for this 'on', per block; then its 'goto' or 'result' is taken.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="goto" type="xs:string" />
    <xs:attribute name="result" type="result" />
  </xs:complexType>

  <xs:simpleType name="schemaName">
    <xs:annotation>
      <xs:documentation>A schema name: 'document.root'.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[^.\s]+(\.[^.\s]+)+" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="messageName">
    <xs:annotation>
      <xs:documentation>The schema name of a message group: document, root and path, e.g. 'Roland.Message32.RQ1'; or document and root for a root that is a message itself, e.g. 'Gx700.SoundChangeRequest'.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[^.\s]+(\.[^.\s]+)+" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="event">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sent" />
      <xs:enumeration value="received" />
      <xs:enumeration value="timeout" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="result">
    <xs:restriction base="xs:string">
      <xs:enumeration value="completed" />
      <xs:enumeration value="rejected" />
      <xs:enumeration value="failed" />
      <xs:enumeration value="timedOut" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
