<?xml version="1.0" encoding="utf-8" ?>
<!--
  MIDI Show Control (7F 02): controls theatrical and live performance equipment (lighting, sound, machinery).
  The commands and their data are not described here.

  Universal System Exclusive messages (MIDI 1.0 Detailed Specification and its Recommended Practices):

    F0 7E <device ID> <sub-ID#1> [<sub-ID#2>] ... F7   non-real time
    F0 7F <device ID> <sub-ID#1> [<sub-ID#2>] ... F7   real time

  The device ID 7F addresses all devices. Each message is a root of its own: a dump that is a message itself
  (see src/Jacobi.Midi.Device/Messages/readme.md); its header comes from the nodeDefs universalNonRealTime and
  universalRealTime of the 'midi' schema.
  Multi-byte values are 7 bits per byte, least significant byte first (lsb14, lsb21, lsb28, lsb35), unless noted.
-->
<schema name="Midi.ShowControl">
  <includes>
    <include schema="midi" />
  </includes>
  <members>
    <group name="Command" nodeDef="Midi.universalRealTime" midi.doc="A MIDI Show Control command (7F 02).">
      <members>
        <field name="SubId1" datatype="sys.uint8" value="0x02" />
        <field name="CommandFormat" datatype="sys.uint8" midi.doc="The kind of equipment: e.g. 01 lighting, 10 sound, 7F all types." />
        <field name="Command" datatype="sys.uint8" midi.doc="The command: e.g. 01 GO, 02 STOP, 03 RESUME." />
        <field name="Data" nodeDef="Midi.data" midi.doc="The data of the command." />
      </members>
    </group>
  </members>
</schema>
