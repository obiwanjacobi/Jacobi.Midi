<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Jacobi.Midi.Console.App"
             RequestedThemeVariant="Dark">

    <!-- the look (palette, chrome, kit) is added in code: see Looks.Apply -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Jacobi.Midi.Console/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <!-- a flyout inherits the cursor of the control it opens on (a knob's up-down): it has the arrow -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </Application.Styles>
</Application>
