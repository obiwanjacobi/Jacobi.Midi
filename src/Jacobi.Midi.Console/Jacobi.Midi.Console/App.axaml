<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Jacobi.Midi.Console.App"
             RequestedThemeVariant="Dark">

    <!-- the look (palette, chrome, kit) is added in code: see ConsoleLooks.Apply -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Jacobi.Midi.Console/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <!-- a flyout inherits the cursor of the control it opens on (a knob's up-down): it has the arrow -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <!--
            scroll bars stay expanded: no hover needed to grab them while designing.
            The scroll viewer inside a control template (list, tree, text box, drop-down) gets AllowAutoHide by a template binding
            to the attached ScrollViewer.AllowAutoHide of its control, which overrides a ScrollViewer style:
            the attached property is set on all templated controls (a ScrollViewer is one too).
            :is() matches the derived types too; a plain type selector only matches that exact type.
        -->
        <Style Selector=":is(TemplatedControl)">
            <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        </Style>
    </Application.Styles>
</Application>
