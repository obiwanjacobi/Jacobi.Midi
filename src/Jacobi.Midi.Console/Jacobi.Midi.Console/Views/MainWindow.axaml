<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Jacobi.Midi.Console.Views"
        xmlns:vm="using:Jacobi.Midi.Console.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Jacobi.Midi.Console.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding SelectedDashboard.Origin.Name, StringFormat='MIDI Console - {0}', FallbackValue='MIDI Console', TargetNullValue='MIDI Console'}"
        Width="1200"
        Height="800"
        MinWidth="640"
        MinHeight="480"
        Background="{DynamicResource ConsoleBackgroundBrush}">
    <views:MainView />
</Window>
