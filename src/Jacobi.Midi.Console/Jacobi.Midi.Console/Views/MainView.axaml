<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jacobi.Midi.Console.ViewModels"
             xmlns:controls="using:Jacobi.Midi.Console.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Jacobi.Midi.Console.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource ConsoleBackgroundBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,14" Background="{DynamicResource ConsolePlateBrush}">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource ConsoleTextBrush}" />
        </Border>

        <!--
            Until the dashboard canvas exists: a fixed section that shows the layers at work. The section overrides
            the accent (as a device palette will), Resonance has its own colour, Tone is bipolar, Drive is unknown.
        -->
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="18" HorizontalAlignment="Left">
                <Border Background="{DynamicResource ConsolePlateBrush}" CornerRadius="14" Padding="18,14">
                    <Border.Resources>
                        <SolidColorBrush x:Key="ConsoleAccentBrush" Color="#D9581A" />
                    </Border.Resources>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Filter · synth" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ConsoleTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:KnobControl Label="Cutoff" Minimum="0" Maximum="127" Value="64" />
                            <controls:KnobControl Label="Resonance" Value="35">
                                <controls:KnobControl.Resources>
                                    <SolidColorBrush x:Key="ConsoleAccentBrush" Color="#3F8A4A" />
                                </controls:KnobControl.Resources>
                            </controls:KnobControl>
                            <controls:KnobControl Label="Tone" Minimum="-50" Maximum="50" Value="18" />
                            <controls:KnobControl Label="Drive" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
