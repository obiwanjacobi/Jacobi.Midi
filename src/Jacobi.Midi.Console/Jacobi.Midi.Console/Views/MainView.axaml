<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jacobi.Midi.Console.ViewModels"
             xmlns:parameters="using:Jacobi.Midi.Console.Core.Parameters"
             xmlns:palettes="using:Jacobi.Midi.Console.Core.Palettes"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Jacobi.Midi.Console.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource ConsoleBackgroundBrush}">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </UserControl.KeyBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,10" Background="#40000000">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Dashboards}" SelectedItem="{Binding SelectedDashboard}" MinWidth="220" FontSize="16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="parameters:DashboardSession">
                                <TextBlock Text="{Binding Dashboard.Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="+" ToolTip.Tip="Open a dashboard next to the open ones" Command="{Binding OpenDashboardCommand}" />
                    <Button Content="✕" ToolTip.Tip="Close the dashboard" Command="{Binding CloseDashboardCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="Edit" IsChecked="{Binding IsEditing}" CornerRadius="4,0,0,4" />
                        <ToggleButton Content="Play" IsChecked="{Binding IsPlaying}" CornerRadius="0,4,4,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEditing}">
                        <Button Content="↶" ToolTip.Tip="{Binding UndoTip}" Command="{Binding UndoCommand}" />
                        <Button Content="↷" ToolTip.Tip="{Binding RedoTip}" Command="{Binding RedoCommand}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" ToolTip.Tip="Save the dashboard and the rig when they changed" Command="{Binding SaveCommand}" />
                    <Button Content="Save as…">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Dashboard…" Command="{Binding SaveDashboardAsCommand}" />
                                <MenuItem Header="Rig…" Command="{Binding SaveRigAsCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Open rig…" Command="{Binding OpenRigCommand}" />
                    <Button Content="Load dump…" Command="{Binding LoadDumpCommand}" />
                    <ComboBox ItemsSource="{Binding Looks}" SelectedItem="{Binding SelectedLook}" MinWidth="120" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,6" Background="#40000000">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ConsoleTextBrush}" FontSize="12" />
                <Expander Header="{Binding Problems.Count, StringFormat='Problems ({0})'}"
                          IsVisible="{Binding Problems.Count}">
                    <ItemsControl ItemsSource="{Binding Problems}" MaxHeight="160">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="#FFB4A0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="20,8" Background="#60000000" IsVisible="{Binding IsEditing}">
            <TextBlock Text="Edit: click a control to select it, right-click it for the colour of the part under the pointer. The values are locked."
                       Foreground="{DynamicResource ConsoleTextBrush}" FontSize="12" />
        </Border>

        <!-- the properties of the selected control -->
        <Border DockPanel.Dock="Right" Width="300" Padding="16" Background="#50000000" IsVisible="{Binding IsEditing}">
            <ScrollViewer>
                <Panel>
                    <TextBlock Text="Select a control to see its properties." TextWrapping="Wrap" Opacity="0.7"
                               IsVisible="{Binding Properties, Converter={x:Static ObjectConverters.IsNull}}" />
                    <ContentControl Content="{Binding Properties}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:ControlPropertiesViewModel">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Kind}" FontSize="18" FontWeight="SemiBold" />

                        <TextBlock Text="Label" FontSize="12" Opacity="0.7" />
                        <TextBox Text="{Binding Label, UpdateSourceTrigger=LostFocus}" PlaceholderText="the parameter's name" />

                        <StackPanel Spacing="10" IsVisible="{Binding IsInGrid}">
                            <TextBlock Text="Position in its grid (column, row)" FontSize="12" Opacity="0.7" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <NumericUpDown Value="{Binding Column}" Minimum="0" Increment="1" FormatString="0" ToolTip.Tip="Column (x)" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Row}" Minimum="0" Increment="1" FormatString="0" ToolTip.Tip="Row (y)" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="Size in cells (columns × rows)" FontSize="12" Opacity="0.7" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <NumericUpDown Value="{Binding Columns}" Minimum="1" Increment="1" FormatString="0" ToolTip.Tip="Columns (width)" />
                            <NumericUpDown Grid.Column="1" Value="{Binding Rows}" Minimum="1" Increment="1" FormatString="0" ToolTip.Tip="Rows (height)" />
                        </Grid>

                        <StackPanel Spacing="10" IsVisible="{Binding IsParameter}">
                            <TextBlock Text="Unit" FontSize="12" Opacity="0.7" />
                            <TextBox Text="{Binding Unit, UpdateSourceTrigger=LostFocus}" PlaceholderText="none" />
                            <TextBlock Text="Decimals" FontSize="12" Opacity="0.7" />
                            <TextBox Text="{Binding Decimals, UpdateSourceTrigger=LostFocus}" PlaceholderText="as many as the value has" />
                        </StackPanel>

                        <TextBlock Text="Colours" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                        <Grid ColumnDefinitions="64,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                            <TextBlock Text="Accent" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Tag="{x:Static palettes:ColorArea.Accent}" Click="OnColorClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="16" Height="16" CornerRadius="2" BorderBrush="#80FFFFFF" BorderThickness="1" Background="{Binding AccentBrush}" />
                                    <TextBlock Text="{Binding AccentColor}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Content="✕" ToolTip.Tip="Inherit the colour" Command="{Binding ClearColorCommand}" CommandParameter="{x:Static palettes:ColorArea.Accent}" />

                            <TextBlock Grid.Row="1" Text="Plate" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="1" Tag="{x:Static palettes:ColorArea.Plate}" Click="OnColorClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="16" Height="16" CornerRadius="2" BorderBrush="#80FFFFFF" BorderThickness="1" Background="{Binding PlateBrush}" />
                                    <TextBlock Text="{Binding PlateColor}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="2" Content="✕" ToolTip.Tip="Inherit the colour" Command="{Binding ClearColorCommand}" CommandParameter="{x:Static palettes:ColorArea.Plate}" />

                            <TextBlock Grid.Row="2" Text="Panel" VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="1" Tag="{x:Static palettes:ColorArea.Panel}" Click="OnColorClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="16" Height="16" CornerRadius="2" BorderBrush="#80FFFFFF" BorderThickness="1" Background="{Binding PanelBrush}" />
                                    <TextBlock Text="{Binding PanelColor}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="2" Content="✕" ToolTip.Tip="Inherit the colour" Command="{Binding ClearColorCommand}" CommandParameter="{x:Static palettes:ColorArea.Panel}" />
                        </Grid>

                        <TextBlock Text="Bindings" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                        <ItemsControl ItemsSource="{Binding Bindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Panel>
            </ScrollViewer>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <ContentControl x:Name="DashboardHost" Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
