<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jacobi.Midi.Console.ViewModels"
             xmlns:local="using:Jacobi.Midi.Console.Views"
             xmlns:palettes="using:Jacobi.Midi.Console.Core.Palettes"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Jacobi.Midi.Console.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource ConsoleBackgroundBrush}">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="Button.current:disabled /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#4FA3FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- a page of selector tabs whose option is not (any more) an option of the parameter -->
        <Style Selector="CheckBox.noOption">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="#E05A4F" />
        </Style>
        <Style Selector="SelectableTextBlock.notification">
            <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.notification.problem">
            <Setter Property="Foreground" Value="#FFB4A0" />
        </Style>
        <Style Selector="TextBlock.device">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.paletteItem">
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="DragMove" />
        </Style>
        <!-- the changed marker: the rig or the dashboard has unsaved changes -->
        <Style Selector="TextBlock.changed">
            <Setter Property="Text" Value="●" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#4FA3FF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip.Tip" Value="Unsaved changes" />
        </Style>
        <Style Selector="Border.paletteItem:pointerover">
            <Setter Property="Background" Value="#50FFFFFF" />
        </Style>
        <!-- a segment of a switch (e.g. Edit/Play): radio buttons (one of the panel is chosen; pressing the chosen one
             keeps it) with the look of toggle buttons -->
        <Style Selector="RadioButton.segment">
            <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
        </Style>
    </UserControl.Styles>

    <Panel>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,10" Background="#40000000">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- the file operations of the rig and the dashboard -->
                    <Button ToolTip.Tip="Save, open a rig or a dashboard, load a dump">
                        <Panel>
                            <TextBlock Text="☰" />
                            <TextBlock Classes="changed" FontSize="8" Margin="0,-6,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                        <Binding Path="RigOrigin.IsChanged" />
                                        <Binding Path="SelectedDashboard.Origin.IsChanged" FallbackValue="{x:False}" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                        </Panel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Open">
                                    <MenuItem Header="Rig…" Command="{Binding OpenRigCommand}" />
                                    <MenuItem Header="Dashboard…" ToolTip.Tip="Open a dashboard next to the open ones" Command="{Binding OpenDashboardCommand}" />
                                    <MenuItem Header="Dump…" ToolTip.Tip="Load the values of the devices from a dump file (offline)" Command="{Binding LoadDumpCommand}" />
                                </MenuItem>
                                <MenuItem Header="Save">
                                    <MenuItem Header="Dashboard" Command="{Binding SaveDashboardCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="changed" IsVisible="{Binding SelectedDashboard.Origin.IsChanged, FallbackValue={x:False}}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Rig" Command="{Binding SaveRigCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Classes="changed" IsVisible="{Binding RigOrigin.IsChanged}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="All" InputGesture="Ctrl+S" ToolTip.Tip="Save the dashboard and the rig when they changed (Ctrl+S)" Command="{Binding SaveCommand}" />
                                </MenuItem>
                                <MenuItem Header="Save as">
                                    <MenuItem Header="Dashboard…" Command="{Binding SaveDashboardAsCommand}" />
                                    <MenuItem Header="Rig…" Command="{Binding SaveRigAsCommand}" />
                                </MenuItem>
                                <MenuItem Header="Close dashboard" Command="{Binding CloseDashboardCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <ComboBox ItemsSource="{Binding Dashboards}" SelectedItem="{Binding SelectedDashboard}" MinWidth="220" FontSize="16">
                        <ComboBox.ItemTemplate>
                            <!-- each dashboard with its changed marker (also the selected one, in the box) -->
                            <DataTemplate x:DataType="vm:DashboardEntry">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Dashboard.Name}" />
                                    <TextBlock Classes="changed" IsVisible="{Binding Origin.IsChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- a new dashboard is built in Edit mode -->
                    <Button Content="+" ToolTip.Tip="A new dashboard" Command="{Binding NewDashboardCommand}" IsVisible="{Binding IsEditing}" />                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEditing}">
                        <Button Content="↶" ToolTip.Tip="{Binding UndoTip}" Command="{Binding UndoCommand}" />
                        <Button Content="↷" ToolTip.Tip="{Binding RedoTip}" Command="{Binding RedoCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="segment" Content="Edit" IsChecked="{Binding IsEditing}" CornerRadius="4,0,0,4" />
                        <RadioButton Classes="segment" Content="Play" IsChecked="{Binding IsPlaying}" CornerRadius="0,4,4,0" />
                    </StackPanel>
                    <!-- the MIDI bar: in Play mode where the values come from, Offline (dump files) or MIDI (the devices of
                         the rig); Edit mode is always connected. And the connection of each device. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Midi.IsAvailable}" IsVisible="{Binding IsPlaying}">
                            <RadioButton Classes="segment" Content="Offline" IsChecked="{Binding Midi.IsOffline}" CornerRadius="4,0,0,4" ToolTip.Tip="The values come from dump files (Open › Dump…)" />
                            <RadioButton Classes="segment" Content="MIDI" IsChecked="{Binding Midi.IsMidi}" CornerRadius="0,4,4,0" ToolTip.Tip="Connect the devices of the rig to their MIDI endpoints" />
                        </StackPanel>
                        <Button ToolTip.Tip="The connections of the devices">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Midi.SummaryBrush}" />
                                <TextBlock Text="{Binding Midi.Summary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="6" MinWidth="300" MaxWidth="480">
                                        <TextBlock Text="Devices" FontWeight="SemiBold" />
                                        <TextBlock Text="Not connected: in Play mode the values come from dump files; switch to MIDI to connect the devices of the rig." IsVisible="{Binding !Midi.IsConnected}" Opacity="0.7" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Midi.Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ConnectionRow">
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,2">
                                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Brush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Alias}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.8" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- Play mode with MIDI: the values of the dashboard requested again from its online devices -->
                        <Button Content="⟳ Request data" Command="{Binding RequestDataCommand}" IsVisible="{Binding IsPlaying}"
                                ToolTip.Tip="Request the values of the dashboard's parameters from its online devices again" />
                    </StackPanel>
                </StackPanel>
                <!-- Play mode: the look of the dashboard (in Edit mode it is in the dashboard's properties) -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding Looks}" SelectedItem="{Binding DashboardLook}" MinWidth="120"
                          VerticalAlignment="Center" IsVisible="{Binding IsPlaying}" IsEnabled="{Binding SelectedDashboard, Converter={x:Static ObjectConverters.IsNotNull}}"
                          ToolTip.Tip="The look of the dashboard: saved with it" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,6" Background="#40000000">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ConsoleTextBrush}" FontSize="12" TextWrapping="Wrap" />
                <Expander IsVisible="{Binding Notifications.Count}">
                    <!-- all notifications, scrolled when they do not fit; selectable, to copy them; a problem in its own color -->
                    <!-- the reports (what happened) can be dismissed, one by one (✕) or all (Clear); the problems of the current state stay until their cause is gone -->
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding NotificationsHeader}" VerticalAlignment="Center" />
                            <Button Content="Clear" FontSize="12" Padding="8,0" VerticalAlignment="Center"
                                    ToolTip.Tip="Remove the reports of what happened; the problems of the rig and the dashboard stay until they are solved"
                                    Command="{Binding ClearReportsCommand}" />
                        </StackPanel>
                    </Expander.Header>
                    <DockPanel>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:Notification">
                                        <DockPanel Margin="0,0,12,4">
                                            <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Padding="4,0" Margin="8,0,0,0" VerticalAlignment="Top"
                                                    IsVisible="{Binding IsReport}" ToolTip.Tip="Remove this report"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DismissReportCommand}"
                                                    CommandParameter="{Binding}" />
                                            <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                                                                 Classes="notification" Classes.problem="{Binding IsProblem}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="20,8" Background="#60000000" IsVisible="{Binding IsEditing}">
            <TextBlock Text="Edit: drag parameters and groups from the rig, or controls from the palettes, onto the dashboard; drop a parameter on a control to bind it. Click a control to select it (Esc or a click beside the dashboard selects nothing), drag it to move it (also into another grid or section), Delete deletes it, right-click it for the color of the part under the pointer. The values are locked."
                       Foreground="{DynamicResource ConsoleTextBrush}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Edit mode: the rig and palettes, the dashboard and the properties, with a splitter between them (the side
             columns are closed in Play mode, see MainView.axaml.cs) -->
        <Grid x:Name="Panes" ColumnDefinitions="300,Auto,*,Auto,320">
        <!-- the rig with the parameters of its devices, and the palettes of controls: what is dragged onto the dashboard -->
        <Border Grid.Column="0" Padding="12" Background="#50000000" IsVisible="{Binding IsEditing}">
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="RIG" Classes="heading" VerticalAlignment="Center" Margin="0" />
                        <TextBlock Classes="changed" IsVisible="{Binding RigOrigin.IsChanged}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="+" ToolTip.Tip="Add a device to the rig for an address map of the schemas; bring in the schemas of a schema file or assembly; or start a new rig" Click="OnAddDeviceClicked" />
                </Grid>
                <TreeView Grid.Row="1" ItemsSource="{Binding RigTree}" SelectedItem="{Binding SelectedRigItem}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="vm:RigTreeItem" ItemsSource="{Binding Children}">
                            <Border Background="Transparent" PointerPressed="OnDragSourcePressed" ToolTip.Tip="{Binding Detail}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                            Background="{Binding ColorBrush}" IsVisible="{Binding IsDevice}"
                                            BorderBrush="#80FFFFFF" BorderThickness="1" />
                                    <TextBlock Text="{Binding Name}" Classes.device="{Binding IsDevice}" />
                                    <!-- the usage mark: a control of the dashboard is bound to the field (fainter: to a field inside it) -->
                                    <TextBlock Text="◆" FontSize="9" Foreground="#8BD17C" VerticalAlignment="Center"
                                               IsVisible="{Binding IsUsed}" Opacity="{Binding UsageOpacity}" ToolTip.Tip="{Binding UsageTip}" />
                                    <!-- the device's MIDI connection, in MIDI mode -->
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding ConnectionBrush}"
                                             IsVisible="{Binding HasConnection}" ToolTip.Tip="{Binding ConnectionTip}" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <TextBlock Grid.Row="2" Text="CONTROLS" Classes="heading" />
                <ItemsControl Grid.Row="3" ItemsSource="{Binding ControlPalette}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteItem">
                            <Border Classes="paletteItem" PointerPressed="OnDragSourcePressed" ToolTip.Tip="{Binding Tip}" Opacity="{Binding Opacity}">
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="4" Text="LAYOUT" Classes="heading" />
                <ItemsControl Grid.Row="5" ItemsSource="{Binding LayoutPalette}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteItem">
                            <Border Classes="paletteItem" PointerPressed="OnDragSourcePressed" ToolTip.Tip="{Binding Tip}">
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="#30FFFFFF" IsVisible="{Binding IsEditing}" />
        <GridSplitter Grid.Column="3" Width="5" ResizeDirection="Columns" Background="#30FFFFFF" IsVisible="{Binding IsEditing}" />

        <!-- the selected device, the selected control, or the dashboard -->
        <Border Grid.Column="4" Padding="16" Background="#50000000" IsVisible="{Binding IsEditing}">
            <ScrollViewer>
                <Panel>
                    <StackPanel Spacing="10" IsVisible="{Binding !ShowsSelection}">
                        <TextBlock Text="Dashboard" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Name" Classes="caption" />
                        <TextBox Text="{Binding DashboardName, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="Zoom (%): the whole dashboard, saved with it" Classes="caption" />
                        <NumericUpDown Value="{Binding DashboardZoom}" Minimum="25" Maximum="400" Increment="10" FormatString="0" />
                        <TextBlock Text="Look: the dashboard is shown with it, saved with it" Classes="caption" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding Looks}" SelectedItem="{Binding DashboardLook}" HorizontalAlignment="Stretch" />
                        <!-- the device aliases the dashboard uses: renaming one renames it throughout the dashboard -->
                        <TextBlock Text="Devices (aliases): renaming one renames it on all controls of the dashboard" Classes="caption" TextWrapping="Wrap"
                                   IsVisible="{Binding DashboardAliases.Count}" />
                        <ItemsControl ItemsSource="{Binding DashboardAliases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardAliasViewModel">
                                    <StackPanel Spacing="2" Margin="0,0,0,6">
                                        <TextBox Text="{Binding Alias, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Text="The rig has no device with this alias: its controls do not work." FontSize="12" TextWrapping="Wrap"
                                                   Foreground="#FFB4A0" IsVisible="{Binding !IsInRig}" />
                                        <!-- the exchanges of the device's exchange file the values are received and the changes sent with (Play mode with MIDI) -->
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2" Margin="0,2,0,0">
                                            <TextBlock Text="Receive with" Classes="caption" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding ExchangeNames}" Text="{Binding Receive, UpdateSourceTrigger=LostFocus}"
                                                      HorizontalAlignment="Stretch" PlaceholderText="e.g. requestData"
                                                      ToolTip.Tip="The exchange the values are received with from the device (Play mode with MIDI); empty: not received" />
                                            <TextBlock Grid.Row="1" Text="Send with" Classes="caption" VerticalAlignment="Center" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" ItemsSource="{Binding ExchangeNames}" Text="{Binding Send, UpdateSourceTrigger=LostFocus}"
                                                      HorizontalAlignment="Stretch" PlaceholderText="e.g. sendData"
                                                      ToolTip.Tip="The exchange the changes of the values are sent to the device with (Play mode with MIDI); empty: not sent" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Select a control to see its properties, or a device in the rig. Esc, or a click beside the dashboard, comes back here." TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <ContentControl Content="{Binding DeviceProperties}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:DevicePropertiesViewModel">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Device" FontSize="18" FontWeight="SemiBold" />
                                        <Button Grid.Column="1" Content="Remove" ToolTip.Tip="Take the device out of the rig" Command="{Binding RemoveCommand}" />
                                    </Grid>

                                    <TextBlock Text="Alias (the name dashboards use)" Classes="caption" />
                                    <TextBox Text="{Binding Alias, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="Name" Classes="caption" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" PlaceholderText="e.g. the product name" />
                                    <TextBlock Text="Map root (the address map of the device)" Classes="caption" />
                                    <ComboBox ItemsSource="{Binding MapRoots}" SelectedItem="{Binding MapRoot}" HorizontalAlignment="Stretch" />
                                    <!-- the device values: a name (the map root's required names, or any other) and a value per row -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Device values" Classes="caption" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="+" FontSize="12" Padding="6,0" ToolTip.Tip="Add a device value" Command="{Binding AddDeviceValueCommand}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DeviceValues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeviceValueViewModel">
                                                <StackPanel Spacing="2" Margin="0,0,0,4">
                                                    <Grid ColumnDefinitions="*,80,Auto" ColumnSpacing="4">
                                                        <ComboBox IsEditable="True" ItemsSource="{Binding Names}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                                  HorizontalAlignment="Stretch" PlaceholderText="name, e.g. deviceId" />
                                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" PlaceholderText="0x10" />
                                                        <Button Grid.Column="2" Content="✕" ToolTip.Tip="Remove the device value" Command="{Binding RemoveCommand}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Mark}" IsVisible="{Binding HasMark}" FontSize="11" Opacity="0.7" FontStyle="Italic" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding DeviceValuesProblem}" IsVisible="{Binding DeviceValuesProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                                    <TextBlock Text="MIDI" Classes="heading" />
                                    <TextBlock Text="Endpoint" Classes="caption" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <ComboBox ItemsSource="{Binding EndpointNames}" SelectedItem="{Binding EndpointName}" HorizontalAlignment="Stretch"
                                                  PlaceholderText="not connected" />
                                        <Button Grid.Column="1" Content="✕" ToolTip.Tip="Not connected to MIDI" Command="{Binding ClearEndpointCommand}" IsEnabled="{Binding HasEndpoint}" />
                                    </Grid>
                                    <TextBlock Text="UMP group to send on" Classes="caption" />
                                    <ComboBox ItemsSource="{Binding SendGroupNames}" SelectedIndex="{Binding EndpointSendGroup}" HorizontalAlignment="Stretch" IsEnabled="{Binding HasEndpoint}" />
                                    <TextBlock Text="UMP group to receive on" Classes="caption" />
                                    <ComboBox ItemsSource="{Binding ReceiveGroupNames}" SelectedIndex="{Binding EndpointReceiveGroup}" HorizontalAlignment="Stretch" IsEnabled="{Binding HasEndpoint}"
                                              ToolTip.Tip="Usually the same group as for sending; differs when the device is cabled to ports of different groups" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding ConnectionBrush}" />
                                        <TextBlock Text="{Binding ConnectionText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" MaxWidth="250" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsConnected}">
                                        <Button Content="Identity request" FontSize="12" Padding="6,2" Command="{Binding RequestIdentityCommand}"
                                                ToolTip.Tip="Ask the devices on the endpoint and groups to identify themselves (universal Identity Request); older devices do not answer it. Changes no values." />
                                        <Button Content="Request data" FontSize="12" Padding="6,2" Command="{Binding ProbeDataCommand}"
                                                ToolTip.Tip="Check that the device answers a request of the first parameter of its map, with its schema and device values. The values are not kept." />
                                    </StackPanel>
                                    <SelectableTextBlock Text="{Binding TestResult}" IsVisible="{Binding TestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                         TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace" />

                                    <TextBlock Text="Colors of its controls" Classes="heading" />
                                    <Grid ColumnDefinitions="64,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                        <TextBlock Text="Accent" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Tag="{x:Static palettes:ColorArea.Accent}" Click="OnDeviceColorClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="16" Height="16" CornerRadius="2" BorderBrush="#80FFFFFF" BorderThickness="1" Background="{Binding AccentBrush}" />
                                                <TextBlock Text="{Binding AccentColor}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Content="✕" ToolTip.Tip="The look's color" Command="{Binding ClearColorCommand}" CommandParameter="{x:Static palettes:ColorArea.Accent}" />

                                        <TextBlock Grid.Row="1" Text="Plate" VerticalAlignment="Center" />
                                        <Button Grid.Row="1" Grid.Column="1" Tag="{x:Static palettes:ColorArea.Plate}" Click="OnDeviceColorClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="16" Height="16" CornerRadius="2" BorderBrush="#80FFFFFF" BorderThickness="1" Background="{Binding PlateBrush}" />
                                                <TextBlock Text="{Binding PlateColor}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="2" Content="✕" ToolTip.Tip="The look's color" Command="{Binding ClearColorCommand}" CommandParameter="{x:Static palettes:ColorArea.Plate}" />

                                        <TextBlock Grid.Row="2" Text="Panel" VerticalAlignment="Center" />
                                        <Button Grid.Row="2" Grid.Column="1" Tag="{x:Static palettes:ColorArea.Panel}" Click="OnDeviceColorClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="16" Height="16" CornerRadius="2" BorderBrush="#80FFFFFF" BorderThickness="1" Background="{Binding PanelBrush}" />
                                                <TextBlock Text="{Binding PanelColor}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="2" Grid.Column="2" Content="✕" ToolTip.Tip="The look's color" Command="{Binding ClearColorCommand}" CommandParameter="{x:Static palettes:ColorArea.Panel}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <ContentControl Content="{Binding Properties}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:ControlPropertiesViewModel">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Kind}" FontSize="18" FontWeight="SemiBold" />
                                        <Button Grid.Column="1" Content="Delete" ToolTip.Tip="Delete the control and the controls inside it (Delete)" Command="{Binding DeleteCommand}" />
                                    </Grid>
                                    <StackPanel Spacing="6" IsVisible="{Binding CanChangeKind}">
                                        <TextBlock Text="Change to" Classes="caption" />
                                        <ItemsControl ItemsSource="{Binding Kinds}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:KindOption">
                                                    <Button Content="{Binding Name}" Command="{Binding ChangeCommand}" IsEnabled="{Binding CanChange}"
                                                            Classes.current="{Binding IsCurrent}" FontSize="12" Padding="8,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Text="Label" Classes="caption" />
                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=LostFocus}" PlaceholderText="the parameter's name" />

                                    <StackPanel Spacing="10" IsVisible="{Binding IsInGrid}">
                                        <TextBlock Text="Position in its grid (column, row)" Classes="caption" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <NumericUpDown Value="{Binding Column}" Minimum="0" Increment="1" FormatString="0" ToolTip.Tip="Column (x)" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding Row}" Minimum="0" Increment="1" FormatString="0" ToolTip.Tip="Row (y)" />
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Text="Size in cells (columns × rows)" Classes="caption" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <NumericUpDown Value="{Binding Columns}" Minimum="1" Increment="1" FormatString="0" ToolTip.Tip="Columns (width)" IsEnabled="{Binding CanResize}" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding Rows}" Minimum="1" Increment="1" FormatString="0" ToolTip.Tip="Rows (height)" IsEnabled="{Binding CanResize}" />
                                    </Grid>

                                    <StackPanel Spacing="10" IsVisible="{Binding IsParameter}">
                                        <TextBlock Text="Unit" Classes="caption" />
                                        <TextBox Text="{Binding Unit, UpdateSourceTrigger=LostFocus}" PlaceholderText="none" />
                                        <TextBlock Text="Decimals" Classes="caption" />
                                        <TextBox Text="{Binding Decimals, UpdateSourceTrigger=LostFocus}" PlaceholderText="as many as the value has" />
                                    </StackPanel>

                                    <StackPanel Spacing="10" IsVisible="{Binding HasFace}">
                                        <TextBlock Text="Face size (1 is its own size)" Classes="caption" />
                                        <NumericUpDown Value="{Binding FaceScale}" Minimum="{Binding MinimumFaceScale}" Maximum="{Binding MaximumFaceScale}"
                                                       Increment="{Binding FaceScaleStep}" FormatString="0.0#"
                                                       ToolTip.Tip="The size of the face only, not of the plate, label or value: a face larger than its room on the plate is cut off" />
                                    </StackPanel>

                                    <StackPanel Spacing="10" IsVisible="{Binding IsSelector}">
                                        <TextBlock Text="Presentation" Classes="caption" />
                                        <ComboBox ItemsSource="{Binding Presentations}" SelectedItem="{Binding Presentation}" HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="List: the selected option with a droplist. Buttons: a button per option, more rows when they do not fit" />
                                    </StackPanel>

                                    <StackPanel Spacing="10" IsVisible="{Binding IsFlex}">
                                        <TextBlock Text="Gap between the controls (cells)" Classes="caption" />
                                        <NumericUpDown Value="{Binding Gap}" Minimum="0" Increment="1" FormatString="0" />
                                        <CheckBox Content="Wrap onto more lines" IsChecked="{Binding Wrap}" />
                                    </StackPanel>

                                    <TextBlock Text="Colors" Classes="heading" />
                                    <Grid ColumnDefinitions="64,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                        <TextBlock Text="Accent" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Tag="{x:Static palettes:ColorArea.Accent}" Click="OnColorClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="16" Height="16" CornerRadius="2" BorderBrush="#80FFFFFF" BorderThickness="1" Background="{Binding AccentBrush}" />
                                                <TextBlock Text="{Binding AccentColor}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Content="✕" ToolTip.Tip="Inherit the color" Command="{Binding ClearColorCommand}" CommandParameter="{x:Static palettes:ColorArea.Accent}" />

                                        <TextBlock Grid.Row="1" Text="Plate" VerticalAlignment="Center" />
                                        <Button Grid.Row="1" Grid.Column="1" Tag="{x:Static palettes:ColorArea.Plate}" Click="OnColorClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="16" Height="16" CornerRadius="2" BorderBrush="#80FFFFFF" BorderThickness="1" Background="{Binding PlateBrush}" />
                                                <TextBlock Text="{Binding PlateColor}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="2" Content="✕" ToolTip.Tip="Inherit the color" Command="{Binding ClearColorCommand}" CommandParameter="{x:Static palettes:ColorArea.Plate}" />

                                        <TextBlock Grid.Row="2" Text="Panel" VerticalAlignment="Center" />
                                        <Button Grid.Row="2" Grid.Column="1" Tag="{x:Static palettes:ColorArea.Panel}" Click="OnColorClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="16" Height="16" CornerRadius="2" BorderBrush="#80FFFFFF" BorderThickness="1" Background="{Binding PanelBrush}" />
                                                <TextBlock Text="{Binding PanelColor}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="2" Grid.Column="2" Content="✕" ToolTip.Tip="Inherit the color" Command="{Binding ClearColorCommand}" CommandParameter="{x:Static palettes:ColorArea.Panel}" />
                                    </Grid>

                                    <TextBlock Text="Device and base" Classes="heading" />
                                    <TextBlock Text="Device (alias)" Classes="caption" />
                                    <TextBox Text="{Binding Device, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding InheritedDevice}" />
                                    <TextBlock Text="Base (the path the bindings are relative to)" Classes="caption" />
                                    <TextBox Text="{Binding Base, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding InheritedBase}" TextWrapping="Wrap" />

                                    <StackPanel Spacing="8" IsVisible="{Binding IsLayout}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Index variables (name, first item)" Classes="heading" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="+" ToolTip.Tip="Declare an index variable" Command="{Binding AddVariableCommand}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Variables}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:VariableViewModel">
                                                    <Grid ColumnDefinitions="*,100,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                                        <NumericUpDown Grid.Column="1" Value="{Binding Value}" Minimum="0" Increment="1" FormatString="0" ToolTip.Tip="The index the dashboard starts with (0 is the first item)" />
                                                        <Button Grid.Column="2" Content="✕" ToolTip.Tip="Remove the variable" Command="{Binding RemoveCommand}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="8" IsVisible="{Binding IsEnvelope}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Segments" Classes="heading" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="+" ToolTip.Tip="Add a segment at the end" Command="{Binding AddSegmentCommand}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Segments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SegmentViewModel">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <CheckBox Grid.Column="1" Content="Holds" IsChecked="{Binding Hold}" ToolTip.Tip="Holds (sustains) until note off; one segment holds at most" />
                                                        <Button Grid.Column="2" Content="✕" ToolTip.Tip="Remove the segment with its bindings" Command="{Binding RemoveCommand}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding IsSelectorTabs}">
                                        <TextBlock Text="Pages (an option each)" Classes="heading" />
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsEnabled="{Binding CanChoosePages}"
                                                ToolTip.Tip="Choose the options that have a page">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding PagesText}" />
                                                <TextBlock Grid.Column="1" Text="▾" Margin="8,0,0,0" />
                                            </Grid>
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <ScrollViewer MaxHeight="400">
                                                        <ItemsControl ItemsSource="{Binding Pages}" MinWidth="200">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:PageChoiceViewModel">
                                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding HasPage}" IsEnabled="{Binding CanChange}" ToolTip.Tip="{Binding Tip}"
                                                                              Classes.noOption="{Binding IsOfNoOption}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Spacing="8" IsVisible="{Binding IsParameter}">
                                        <TextBlock Text="Bindings ([device:]path or $variable)" Classes="heading" />
                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SlotViewModel">
                                                    <StackPanel Spacing="4" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Name}" Classes="caption" />
                                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" PlaceholderText="not bound: drop a parameter on the control"
                                                                 TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Panel>
            </ScrollViewer>
        </Border>

        <!-- the room around the dashboard: a press on it selects nothing -->
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" Background="Transparent" PointerPressed="OnBesideDashboardPressed">
            <ContentControl x:Name="DashboardHost" Margin="24" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
        </Grid>
    </DockPanel>

    <!-- modal overlay of a confirmation (e.g. closing a changed dashboard) -->
    <Panel IsVisible="{Binding ConfirmDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
        <local:ConfirmView DataContext="{Binding ConfirmDialog}" />
    </Panel>
    </Panel>
</UserControl>
