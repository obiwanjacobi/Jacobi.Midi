<!--
    A confirmation dialog: shown as an overlay (so it works in the Desktop and the Browser host)
    to confirm an action that cannot be undone, such as closing a dashboard with unsaved changes. See ConfirmViewModel.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jacobi.Midi.Console.ViewModels"
             x:Class="Jacobi.Midi.Console.Views.ConfirmView"
             x:DataType="vm:ConfirmViewModel">

    <Grid Background="#99000000">
        <Border MaxWidth="560" Margin="32" Padding="20" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource ConsoleBackgroundBrush}"
                BorderBrush="#30FFFFFF" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Caption}" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Opacity="0.7" Foreground="{DynamicResource ConsoleTextBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource ConsoleTextBrush}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource ConsoleTextBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="{Binding ConfirmText}" Classes="accent" Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
