<!--
    The Foundry look: brushed steel plates held by screws on cast iron, bakelite and brass, amber readouts.
    The palette (materials and colours for the faces) and the chrome of controls and sections.
    The accent and the colours derived from it (ConsoleAccentBrush, ConsoleAccentTextBrush, ConsoleAccentDisplayBrush)
    come from the look in code (see ConsoleLooks and PaletteBrushes); a control or section with a colour of its own or
    of its device overrides them, and its plate (ConsolePlateBrush, ConsolePlateTextBrush) and panel
    (ConsoleSectionBrush) with this dictionary's materials tinted. Elements in the accent have the class accentArea:
    a right-click on them picks the accent, elsewhere the plate or the panel.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:Jacobi.Midi.Console.Chrome">

    <!-- palette -->
    <RadialGradientBrush x:Key="ConsoleBackgroundBrush" Center="30%,0%" GradientOrigin="30%,0%" RadiusX="100%" RadiusY="100%">
        <GradientStop Offset="0" Color="#3B3733" />
        <GradientStop Offset="0.75" Color="#1B1917" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#E2DACB" />
    <SolidColorBrush x:Key="ConsolePlateTextBrush" Color="#242424" />
    <SolidColorBrush x:Key="ConsoleTrackBrush" Color="#5A5D60" />
    <RadialGradientBrush x:Key="ConsoleBodyBrush" Center="40%,35%" GradientOrigin="40%,35%" RadiusX="70%" RadiusY="70%">
        <GradientStop Offset="0" Color="#4C4743" />
        <GradientStop Offset="0.6" Color="#1E1B19" />
        <GradientStop Offset="1" Color="#0B0A09" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ConsoleSurfaceBrush" Center="35%,30%" GradientOrigin="35%,30%" RadiusX="75%" RadiusY="75%">
        <GradientStop Offset="0" Color="#FFF1B8" />
        <GradientStop Offset="0.5" Color="#C99A2E" />
        <GradientStop Offset="1" Color="#6E4F12" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="ConsolePointerBrush" Color="#F3E2B0" />
    <SolidColorBrush x:Key="ConsoleDisplayBrush" Color="#1B130A" />
    <SolidColorBrush x:Key="ConsoleDisplayTextBrush" Color="#FFB23E" />
    <LinearGradientBrush x:Key="ConsolePlateBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#CDD0D1" />
        <GradientStop Offset="1" Color="#9A9EA0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ConsoleSectionBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#3E3A36" />
        <GradientStop Offset="1" Color="#2C2926" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="ConsoleScrewBrush" Center="35%,30%" GradientOrigin="35%,30%" RadiusX="70%" RadiusY="70%">
        <GradientStop Offset="0" Color="#F6F6F6" />
        <GradientStop Offset="0.55" Color="#8B8E91" />
        <GradientStop Offset="1" Color="#45474A" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="ConsoleOutlineBrush" Color="#000000" />

    <!-- typography -->
    <FontFamily x:Key="ConsoleLabelFont">$Default</FontFamily>
    <FontFamily x:Key="ConsoleDisplayFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

    <!-- finish -->
    <x:Double x:Key="ConsoleGlowOpacity">0.35</x:Double>

    <!-- a control: a steel plate with four screws, an engraved label and an amber readout -->
    <ControlTheme x:Key="{x:Type chrome:ControlChrome}" TargetType="chrome:ControlChrome">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{DynamicResource ConsolePlateBrush}" CornerRadius="6"
                            BorderBrush="#1A1A1A" BorderThickness="1"
                            BoxShadow="inset 0 1 0 0 #B0FFFFFF, 0 3 6 0 #99000000" />
                    <Ellipse Width="9" Height="9" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource ConsoleScrewBrush}" />
                    <Ellipse Width="9" Height="9" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource ConsoleScrewBrush}" />
                    <Ellipse Width="9" Height="9" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource ConsoleScrewBrush}" />
                    <Ellipse Width="9" Height="9" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource ConsoleScrewBrush}" />
                    <StackPanel Margin="{TemplateBinding Padding}" Spacing="6" HorizontalAlignment="Center">
                        <!-- engraved: a light copy one pixel lower -->
                        <Panel HorizontalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Label, Converter={x:Static chrome:UpperCaseConverter.Instance}}"
                                       FontFamily="{DynamicResource ConsoleLabelFont}"
                                       Margin="0,1,0,0" Foreground="#A0FFFFFF" FontSize="12" FontWeight="SemiBold" LetterSpacing="1.5" />
                            <TextBlock Text="{TemplateBinding Label, Converter={x:Static chrome:UpperCaseConverter.Instance}}"
                                       FontFamily="{DynamicResource ConsoleLabelFont}"
                                       Foreground="{DynamicResource ConsolePlateTextBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="1.5" />
                        </Panel>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
                        <Border Background="{DynamicResource ConsoleDisplayBrush}" CornerRadius="3" Padding="8,2" HorizontalAlignment="Center"
                                BoxShadow="inset 0 1 3 0 #E6000000"
                                IsVisible="{TemplateBinding ValueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{TemplateBinding ValueText}" Foreground="{DynamicResource ConsoleDisplayTextBrush}"
                                       FontFamily="{DynamicResource ConsoleDisplayFont}" FontSize="14" />
                        </Border>
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- a section: a cast iron panel with a tag in the device's colour; the tag in the top inset (Padding, in cells) -->
    <ControlTheme x:Key="{x:Type chrome:SectionFrame}" TargetType="chrome:SectionFrame">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource ConsoleSectionBrush}" BorderBrush="#141210" BorderThickness="1" CornerRadius="10"
                        BoxShadow="inset 0 1 0 0 #14FFFFFF, 0 4 10 0 #80000000">
                    <Panel>
                        <Border Classes="accentArea" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0"
                                Background="{DynamicResource ConsoleAccentBrush}" CornerRadius="3" Padding="12,3"
                                BoxShadow="inset 0 1 0 0 #8CFFFFFF, 0 1 2 0 #B3000000"
                                IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{TemplateBinding Header, Converter={x:Static chrome:UpperCaseConverter.Instance}}"
                                       FontFamily="{DynamicResource ConsoleLabelFont}"
                                       Foreground="{DynamicResource ConsoleAccentTextBrush}" FontSize="12" FontWeight="Bold" LetterSpacing="2" />
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
