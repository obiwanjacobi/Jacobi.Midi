<!--
    The parts all looks share: the templates of the parameter controls (the chrome around a face host, which takes
    the face from the kit of the look) and the brushes of the faces (the palette keys). A look supplies the palette,
    the kit and the chrome themes, in its module (a folder under Looks).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:Jacobi.Midi.Console.Chrome"
                    xmlns:controls="using:Jacobi.Midi.Console.Controls"
                    xmlns:faces="using:Jacobi.Midi.Console.Faces">

    <ControlTheme x:Key="{x:Type controls:KnobControl}" TargetType="controls:KnobControl">
        <Setter Property="Cursor" Value="SizeNorthSouth" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}" Doc="{TemplateBinding Doc}">
                    <faces:FaceHost Kind="Knob" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:FaderControl}" TargetType="controls:FaderControl">
        <Setter Property="Cursor" Value="SizeNorthSouth" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}" Doc="{TemplateBinding Doc}">
                    <faces:FaceHost Kind="Slider" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:SwitchControl}" TargetType="controls:SwitchControl">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}" Doc="{TemplateBinding Doc}">
                    <faces:FaceHost Kind="Switch" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:NumberBoxControl}" TargetType="controls:NumberBoxControl">
        <Setter Property="Cursor" Value="SizeNorthSouth" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}" Doc="{TemplateBinding Doc}">
                    <faces:FaceHost Kind="NumberBox" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:TextControl}" TargetType="controls:TextControl">
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}" Doc="{TemplateBinding Doc}">
                    <faces:FaceHost Kind="Text" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:SelectorControl}" TargetType="controls:SelectorControl">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}" Doc="{TemplateBinding Doc}">
                    <faces:FaceHost Kind="Selector" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:XyPadControl}" TargetType="controls:XyPadControl">
        <Setter Property="Cursor" Value="Cross" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}" Doc="{TemplateBinding Doc}">
                    <faces:FaceHost Kind="XyPad" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:EnvelopeCurveControl}" TargetType="controls:EnvelopeCurveControl">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}" Doc="{TemplateBinding Doc}">
                    <faces:FaceHost Kind="Envelope" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!--
        every face draws with the same keys of the palette, the typography and the finish;
        a look gives them other colors, materials, fonts and effects; every face takes this theme (Face.StyleKeyOverride)
    -->
    <ControlTheme x:Key="{x:Type faces:Face}" TargetType="faces:Face">
        <Setter Property="AccentBrush" Value="{DynamicResource ConsoleAccentBrush}" />
        <Setter Property="AccentDisplayBrush" Value="{DynamicResource ConsoleAccentDisplayBrush}" />
        <Setter Property="TrackBrush" Value="{DynamicResource ConsoleTrackBrush}" />
        <Setter Property="BodyBrush" Value="{DynamicResource ConsoleBodyBrush}" />
        <Setter Property="SurfaceBrush" Value="{DynamicResource ConsoleSurfaceBrush}" />
        <Setter Property="PointerBrush" Value="{DynamicResource ConsolePointerBrush}" />
        <Setter Property="DisplayBrush" Value="{DynamicResource ConsoleDisplayBrush}" />
        <Setter Property="DisplayTextBrush" Value="{DynamicResource ConsoleDisplayTextBrush}" />
        <Setter Property="OutlineBrush" Value="{DynamicResource ConsoleOutlineBrush}" />
        <Setter Property="DisplayFont" Value="{DynamicResource ConsoleDisplayFont}" />
        <Setter Property="GlowOpacity" Value="{DynamicResource ConsoleGlowOpacity}" />
    </ControlTheme>

    <!--
        The headers of tabs and selector tabs on a dashboard: in the look's label font and text color, as the labels of
        the controls (upper case, spaced), the selected page in the accent; as high as the two cell rows of the headers
        (GridLayout), so the pages are on the cells.
    -->
    <ControlTheme x:Key="ConsoleTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HeaderTemplate">
            <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static chrome:UpperCaseConverter.Instance}}"
                           FontFamily="{DynamicResource ConsoleLabelFont}" FontSize="12" FontWeight="SemiBold" LetterSpacing="1.5" />
            </DataTemplate>
        </Setter>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ConsoleAccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource ConsoleAccentBrush}" />
        </Style>
    </ControlTheme>

    <!--
        Tabs with their headers at the left (option headers left), and those headers: the headers stacked in the
        columns the builder gives them, otherwise as above. A look may replace both (e.g. the LCARS elbows), by these keys.
    -->
    <ControlTheme x:Key="ConsoleTabControlLeft" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- the header column: the label of the tabs (PagesChrome.Label) in two rows at the top, then the headers -->
                <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
                    <StackPanel>
                        <TextBlock Height="48" Padding="10,0" VerticalAlignment="Top" LineHeight="48" TextTrimming="CharacterEllipsis"
                                   Text="{Binding $parent[TabControl].(chrome:PagesChrome.Label), Converter={x:Static chrome:UpperCaseConverter.Instance}}"
                                   FontFamily="{DynamicResource ConsoleLabelFont}" FontSize="13" FontWeight="Bold" LetterSpacing="2"
                                   Foreground="{DynamicResource ConsoleTextBrush}" />
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </StackPanel>
                    <ContentPresenter Grid.Column="1" Name="PART_SelectedContentHost"
                                      Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ConsoleTabItemLeft" TargetType="TabItem" BasedOn="{StaticResource ConsoleTabItem}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </ControlTheme>

</ResourceDictionary>
