<!--
    The parts all looks share: the templates of the parameter controls (the chrome around a face host, which takes
    the face from the kit of the look) and the brushes of the faces (the palette keys). A look supplies the palette,
    the kit and the chrome themes, in its module (a folder under Looks).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:Jacobi.Midi.Console.Chrome"
                    xmlns:controls="using:Jacobi.Midi.Console.Controls"
                    xmlns:faces="using:Jacobi.Midi.Console.Faces">

    <ControlTheme x:Key="{x:Type controls:KnobControl}" TargetType="controls:KnobControl">
        <Setter Property="Cursor" Value="SizeNorthSouth" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}">
                    <faces:FaceHost Kind="Knob" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:FaderControl}" TargetType="controls:FaderControl">
        <Setter Property="Cursor" Value="SizeNorthSouth" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}">
                    <faces:FaceHost Kind="Slider" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:SwitchControl}" TargetType="controls:SwitchControl">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}">
                    <faces:FaceHost Kind="Switch" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:NumberBoxControl}" TargetType="controls:NumberBoxControl">
        <Setter Property="Cursor" Value="SizeNorthSouth" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}">
                    <faces:FaceHost Kind="NumberBox" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:TextControl}" TargetType="controls:TextControl">
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}">
                    <faces:FaceHost Kind="Text" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:SelectorControl}" TargetType="controls:SelectorControl">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}">
                    <faces:FaceHost Kind="Selector" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:XyPadControl}" TargetType="controls:XyPadControl">
        <Setter Property="Cursor" Value="Cross" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}">
                    <faces:FaceHost Kind="XyPad" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:EnvelopeCurveControl}" TargetType="controls:EnvelopeCurveControl">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <chrome:ControlChrome Label="{TemplateBinding Label}" ValueText="{TemplateBinding ValueText}">
                    <faces:FaceHost Kind="Envelope" State="{TemplateBinding FaceState}" />
                </chrome:ControlChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!--
        every face draws with the same keys of the palette, the typography and the finish;
        a look gives them other colours, materials, fonts and effects; every face takes this theme (Face.StyleKeyOverride)
    -->
    <ControlTheme x:Key="{x:Type faces:Face}" TargetType="faces:Face">
        <Setter Property="AccentBrush" Value="{DynamicResource ConsoleAccentBrush}" />
        <Setter Property="AccentDisplayBrush" Value="{DynamicResource ConsoleAccentDisplayBrush}" />
        <Setter Property="TrackBrush" Value="{DynamicResource ConsoleTrackBrush}" />
        <Setter Property="BodyBrush" Value="{DynamicResource ConsoleBodyBrush}" />
        <Setter Property="SurfaceBrush" Value="{DynamicResource ConsoleSurfaceBrush}" />
        <Setter Property="PointerBrush" Value="{DynamicResource ConsolePointerBrush}" />
        <Setter Property="DisplayBrush" Value="{DynamicResource ConsoleDisplayBrush}" />
        <Setter Property="DisplayTextBrush" Value="{DynamicResource ConsoleDisplayTextBrush}" />
        <Setter Property="OutlineBrush" Value="{DynamicResource ConsoleOutlineBrush}" />
        <Setter Property="DisplayFont" Value="{DynamicResource ConsoleDisplayFont}" />
        <Setter Property="GlowOpacity" Value="{DynamicResource ConsoleGlowOpacity}" />
    </ControlTheme>

</ResourceDictionary>
