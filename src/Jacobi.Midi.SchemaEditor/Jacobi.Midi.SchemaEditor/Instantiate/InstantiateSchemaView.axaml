<!--
    The instantiate dialog: shown as an overlay (so it works in the Desktop and the Browser host)
    to provide the values of a schema root. See InstantiateSchemaViewModel.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inst="using:Jacobi.Midi.SchemaEditor.Instantiate"
             x:Class="Jacobi.Midi.SchemaEditor.Instantiate.InstantiateSchemaView"
             x:DataType="inst:InstantiateSchemaViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextCaptionBrush}" />
        </Style>
        <Style Selector="TextBlock.path">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextLabelBrush}" />
        </Style>
        <!-- the toggle that expands or collapses a group, repeat or repeat item -->
        <Style Selector="ToggleButton.expand">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTip.Tip" Value="Expand or collapse" />
        </Style>
        <Style Selector="ToggleButton.expand:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- includes a part of an address map in what is sent, or leaves it out -->
        <Style Selector="CheckBox.include">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip.Tip" Value="Include in what is sent (Save As, Send)" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- a field: the value as text -->
        <DataTemplate x:DataType="inst:InstanceField">
            <Grid ColumnDefinitions="220,*" ColumnSpacing="12" Margin="0,3" ToolTip.Tip="{Binding Description}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DataType}" Classes="path" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBox Text="{Binding Value}" IsReadOnly="{Binding IsConstant}" PlaceholderText="{Binding Sample}" />
                    <TextBlock Text="{Binding ValueWarning}" Foreground="Orange" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding ValueWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- an item of a repeat: shows the path with its instance index and can be removed from an open repeat;
             the members only get controls while the item is expanded -->
        <DataTemplate x:DataType="inst:InstanceRepeatItem">
            <Border Margin="0,4" Padding="10" CornerRadius="6" Background="{DynamicResource AppBackgroundCardBrush}"
                    BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <ToggleButton Classes="expand" IsChecked="{Binding IsExpanded}">
                            <Panel>
                                <TextBlock Text="▾" IsVisible="{Binding IsExpanded}" />
                                <TextBlock Text="▸" IsVisible="{Binding !IsExpanded}" />
                            </Panel>
                        </ToggleButton>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <CheckBox Classes="include" IsChecked="{Binding IsIncluded}" IsVisible="{Binding CanInclude}" />
                            <TextBlock Text="{Binding DisplayPath}" Classes="caption" />
                            <TextBlock Text="{Binding InstanceText, StringFormat='instance {0}'}" Classes="path" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FieldCountText}" Classes="path" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding Repeat.IsOpen}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ShownMembers}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- the body of an open choice: the selected root -->
        <DataTemplate x:DataType="inst:InstanceBody">
            <Border Margin="0,4" Padding="10" CornerRadius="6" Background="{DynamicResource AppBackgroundCardBrush}"
                    BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton Classes="expand" IsChecked="{Binding IsExpanded}">
                            <Panel>
                                <TextBlock Text="▾" IsVisible="{Binding IsExpanded}" />
                                <TextBlock Text="▸" IsVisible="{Binding !IsExpanded}" />
                            </Panel>
                        </ToggleButton>
                        <CheckBox Classes="include" IsChecked="{Binding IsIncluded}" IsVisible="{Binding CanInclude}" />
                        <TextBlock Text="{Binding DisplayPath}" Classes="path" VerticalAlignment="Center" />
                        <TextBlock Text="address map" Classes="path" VerticalAlignment="Center" IsVisible="{Binding IsAddressMap}" />
                        <TextBlock Text="{Binding FieldCountText}" Classes="path" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Note}" Foreground="Orange" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                    <ItemsControl ItemsSource="{Binding ShownMembers}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- a plain group -->
        <DataTemplate x:DataType="inst:InstanceGroup">
            <Border Margin="0,4" Padding="10" CornerRadius="6" Background="{DynamicResource AppBackgroundCardBrush}"
                    BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton Classes="expand" IsChecked="{Binding IsExpanded}">
                            <Panel>
                                <TextBlock Text="▾" IsVisible="{Binding IsExpanded}" />
                                <TextBlock Text="▸" IsVisible="{Binding !IsExpanded}" />
                            </Panel>
                        </ToggleButton>
                        <CheckBox Classes="include" IsChecked="{Binding IsIncluded}" IsVisible="{Binding CanInclude}" />
                        <TextBlock Text="{Binding DisplayPath}" Classes="caption" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FieldCountText}" Classes="path" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ShownMembers}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- a repeat: its items and, when open, a button to add a copy of the group -->
        <DataTemplate x:DataType="inst:InstanceRepeat">
            <StackPanel Margin="0,4" Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <ToggleButton Classes="expand" IsChecked="{Binding IsExpanded}">
                        <Panel>
                            <TextBlock Text="▾" IsVisible="{Binding IsExpanded}" />
                            <TextBlock Text="▸" IsVisible="{Binding !IsExpanded}" />
                        </Panel>
                    </ToggleButton>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <CheckBox Classes="include" IsChecked="{Binding IsIncluded}" IsVisible="{Binding CanInclude}" />
                        <TextBlock Text="{Binding Name}" Classes="caption" />
                        <TextBlock Text="repeat" Classes="path" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CountText}" Classes="path" VerticalAlignment="Center" />
                        <!-- a repeat of an address map: the item of the address space that is shown (and sent) -->
                        <ComboBox ItemsSource="{Binding ItemIndexes}" SelectedItem="{Binding ItemIndex}" IsVisible="{Binding IsAddressed}"
                                  MinWidth="70" ToolTip.Tip="The item of the address space: its index decides the address the data is sent to" />
                        <TextBlock Text="{Binding FieldCountText}" Classes="path" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Add" Command="{Binding AddItemCommand}" IsVisible="{Binding IsOpen}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ShownItems}" Margin="12,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- a choice: select the alternative; for an open choice the groups that conform to the member node def -->
        <DataTemplate x:DataType="inst:InstanceChoice">
            <StackPanel Margin="0,4" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Name}" Classes="caption" VerticalAlignment="Center" />
                    <TextBlock Text="choice" Classes="path" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MemberNodeDef, StringFormat='open: {0}'}" Classes="path" VerticalAlignment="Center" IsVisible="{Binding IsOpen}" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                          IsEnabled="{Binding CanSelect}" IsVisible="{Binding HasOptions}"
                          PlaceholderText="Select an alternative" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding NoOptionsText}" Classes="note" IsVisible="{Binding HasNoOptions}" />
                <ContentControl Content="{Binding Selected}" Margin="12,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid Background="#99000000">
        <Border MaxWidth="900" MaxHeight="760" Margin="32" Padding="20" CornerRadius="8"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Background="{DynamicResource AppBackgroundPanelBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,14">
                    <TextBlock Text="{Binding Heading}" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Foreground="{DynamicResource AppTextLabelBrush}" />
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextHeadingBrush}" />
                    <TextBlock Text="{Binding Instruction}" Classes="note" TextWrapping="Wrap" IsVisible="{Binding HasRoot}" />
                </StackPanel>
                <!-- what the compilation did that may not be expected (e.g. a schema that was left out) -->
                <Border DockPanel.Dock="Top" IsVisible="{Binding HasWarnings}" Margin="0,0,0,12" Padding="8" CornerRadius="4"
                        BorderBrush="Orange" BorderThickness="1">
                    <ScrollViewer MaxHeight="120">
                        <SelectableTextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextBodyBrush}" />
                    </ScrollViewer>
                </Border>
                <!-- match mode: the buffer to read and the outcome of reading it -->
                <Border DockPanel.Dock="Top" IsVisible="{Binding IsMatch}" Margin="0,0,0,12" Padding="10" CornerRadius="6"
                        Background="{DynamicResource AppBackgroundCardBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
                    <StackPanel Spacing="6" DataContext="{Binding Match}" x:DataType="inst:SysExMatchViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                            <Button Content="Load File…" Command="{Binding LoadFileCommand}" IsEnabled="{Binding CanMatch}"
                                    ToolTip.Tip="Load a SysEx (.syx) file and match its message(s) with the schema" />
                            <Button Grid.Column="1" Content="{Binding ReceiveButtonText}" Command="{Binding ReceiveCommand}" IsEnabled="{Binding CanMatch}"
                                    ToolTip.Tip="Wait for the next SysEx message on the group selected in the MIDI bar and match it" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Buffers}" SelectedItem="{Binding SelectedBuffer}"
                                      IsEnabled="{Binding HasBuffers}" PlaceholderText="No SysEx loaded or received" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="3" Content="Match" Command="{Binding MatchCommand}"
                                    ToolTip.Tip="Read the selected SysEx again, e.g. after selecting the body of an open choice" />
                        </Grid>
                        <SelectableTextBlock Text="{Binding SelectedBuffer.BytesText, FallbackValue=''}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                             TextWrapping="Wrap" Foreground="{DynamicResource AppTextMutedBrush}"
                                             IsVisible="{Binding SelectedBuffer, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding Status}" Classes="note" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Warning}" Foreground="Orange" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />
                        <Border IsVisible="{Binding HasError}" Padding="8" CornerRadius="4" BorderBrush="Orange" BorderThickness="1">
                            <ScrollViewer MaxHeight="140">
                                <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                     Foreground="{DynamicResource AppTextBodyBrush}" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- address map: the messages the included groups are sent in -->
                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Transfer}" Classes="note" TextWrapping="Wrap" Margin="0,0,0,8"
                               IsVisible="{Binding HasTransfer}" />
                    <!-- the outcome of the last Save As or Send -->
                    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Classes="note" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Save As…" Command="{Binding SaveAsCommand}" IsVisible="{Binding HasRoot}"
                                ToolTip.Tip="Serialize the values and save them to a SysEx (.syx) file" />
                        <Button Content="Send" Command="{Binding SendCommand}" IsVisible="{Binding HasRoot}"
                                ToolTip.Tip="Serialize the values and send them to the active MIDI endpoint" />
                        <Button Content="Close" Classes="accent" Command="{Binding CloseCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" DockPanel.Dock="Top"
                           Foreground="{DynamicResource AppTextBodyBrush}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasRoot}">
                    <ContentControl Content="{Binding Root}" Margin="0,0,12,0" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- popup with the problem that prevented Save As or Send (e.g. the execution plan could not be built) -->
        <Grid IsVisible="{Binding HasProblem}" Background="#66000000">
            <Border MaxWidth="760" Margin="48" Padding="20" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AppBackgroundPanelBrush}"
                    BorderBrush="Orange" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CANNOT SERIALIZE" FontSize="11" FontWeight="Bold" LetterSpacing="1.4"
                               Foreground="Orange" Margin="0,0,0,10" />
                    <Button DockPanel.Dock="Bottom" Content="OK" Classes="accent" HorizontalAlignment="Right" Margin="0,14,0,0"
                            Command="{Binding DismissProblemCommand}" />
                    <ScrollViewer MaxHeight="420">
                        <SelectableTextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                             Foreground="{DynamicResource AppTextBodyBrush}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
