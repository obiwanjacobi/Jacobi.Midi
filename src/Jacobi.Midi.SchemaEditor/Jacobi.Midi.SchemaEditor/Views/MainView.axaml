<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jacobi.Midi.SchemaEditor.ViewModels"
             xmlns:models="using:Jacobi.Midi.SchemaEditor.Models"
             xmlns:st="clr-namespace:Jacobi.Midi.SchemaEditor.SchemaTree"
             xmlns:ne="clr-namespace:Jacobi.Midi.SchemaEditor.NodeEditor"
             xmlns:inst="clr-namespace:Jacobi.Midi.SchemaEditor.Instantiate"
             xmlns:rn="clr-namespace:Jacobi.Midi.SchemaEditor.Document"
             xmlns:asm="clr-namespace:Jacobi.Midi.SchemaEditor.Assemblies"
             xmlns:midi="clr-namespace:Jacobi.Midi.SchemaEditor.Midi"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             xmlns:local="clr-namespace:Jacobi.Midi.SchemaEditor.Views"
             x:Class="Jacobi.Midi.SchemaEditor.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppBackgroundBaseBrush}">
        <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource AppBackgroundHeaderBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="32">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="MIDI SCHEMA STUDIO" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextHeadingBrush}" />
                    <TextBlock Text="Author, inspect and reverse-engineer SysEx schemas" FontSize="12" Foreground="{DynamicResource AppTextLabelBrush}" />
                </StackPanel>
                <midi:MidiBarControl Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding MidiBar}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12,8" Background="{DynamicResource AppBackgroundToolbarBrush}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" VerticalAlignment="Center" ToolTip.Tip="Menu">
                    <PathIcon Width="16" Height="16" Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="New schema" Command="{Binding NewDocumentCommand}" />
                            <MenuItem Header="Open files…" Command="{Binding OpenFilesCommand}" />
                            <MenuItem Header="Open assemblies…" Command="{Binding OpenAssembliesCommand}" ToolTip.Tip="Open .dll files to use their embedded schemas and processors" />
                            <Separator />
                            <MenuItem Header="Save" Command="{Binding SaveDocumentCommand}" IsEnabled="{Binding HasSelectedDocument}" />
                            <MenuItem Header="Save as…" Command="{Binding SaveDocumentAsCommand}" IsEnabled="{Binding HasSelectedDocument}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <ListBox Grid.Column="1" ItemsSource="{Binding Documents}"
                         SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <!-- compact items: about the height of the menu and close buttons -->
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,5" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SchemaWorkspaceDocument">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Column="2" VerticalAlignment="Center" ToolTip.Tip="Close the active document"
                        Command="{Binding CloseDocumentCommand}">
                    <PathIcon Width="12" Height="12" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="280,*" ColumnSpacing="1" Background="{DynamicResource AppDividerBrush}">
            <Border Grid.Column="0" Padding="18" Background="{DynamicResource AppBackgroundPanelBrush}">
                <TabControl SelectedIndex="{Binding SelectedLeftTab}" Padding="0">
                    <TabItem Header="Schema">
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Bottom"
                                       Text="Select a node to edit its name, type and documentation."
                                       TextWrapping="Wrap" Margin="0,14,0,0" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                            <st:SchemaTreeControl Documents="{Binding TreeDocuments}"
                                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                                  InstantiateCommand="{Binding InstantiateSchemaCommand}"
                                                  MatchCommand="{Binding MatchSchemaCommand}" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Assemblies">
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Bottom"
                                       Text="The embedded schemas of opened assemblies are shown read-only."
                                       TextWrapping="Wrap" Margin="0,14,0,0" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
                            <asm:AssemblyTreeControl />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="1" Padding="24" Background="{DynamicResource AppBackgroundBaseBrush}">
                <Panel>
                    <ne:NodeEditorControl IsVisible="{Binding ShowNodeEditor}" />
                    <Panel IsVisible="{Binding InspectedAssembly, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <asm:AssemblyDetailsView DataContext="{Binding InspectedAssembly}" />
                    </Panel>
                    <Panel IsVisible="{Binding InspectedNamespace, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <asm:ProcessorNamespaceDetailsView DataContext="{Binding InspectedNamespace}" />
                    </Panel>
                </Panel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="16,8" Background="{DynamicResource AppBackgroundHeaderBrush}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </Border>

        <!-- modal overlay of the instantiate dialog -->
        <Panel Grid.RowSpan="4" IsVisible="{Binding InstantiateDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <inst:InstantiateSchemaView DataContext="{Binding InstantiateDialog}" />
        </Panel>

        <!-- modal overlay of the rename document dialog -->
        <Panel Grid.RowSpan="4" IsVisible="{Binding RenameDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <rn:DocumentView DataContext="{Binding RenameDialog}" />
        </Panel>

        <!-- modal overlay of the close document dialog -->
        <Panel Grid.RowSpan="4" IsVisible="{Binding CloseDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <rn:CloseDocumentView DataContext="{Binding CloseDialog}" />
        </Panel>

        <!-- modal overlay of a confirmation (e.g. delete) -->
        <Panel Grid.RowSpan="4" IsVisible="{Binding ConfirmDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <local:ConfirmView DataContext="{Binding ConfirmDialog}" />
        </Panel>
    </Grid>
</UserControl>
