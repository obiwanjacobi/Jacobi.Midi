<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jacobi.Midi.SchemaEditor.ViewModels"
             xmlns:models="using:Jacobi.Midi.SchemaEditor.Models"
             xmlns:st="clr-namespace:Jacobi.Midi.SchemaEditor.SchemaTree"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             x:Class="Jacobi.Midi.SchemaEditor.Views.MainView"
             x:DataType="vm:MainViewModel">
  
    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="#0B1220">
        <Border Grid.Row="0" Padding="24,16" Background="#111B2C" BorderBrush="#25334A" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="MIDI SCHEMA STUDIO" FontSize="18" FontWeight="Bold" Foreground="#E7EEF8" />
                    <TextBlock Text="Author, inspect and reverse-engineer SysEx schemas" FontSize="12" Foreground="#94A4BA" />
                </StackPanel>
                <Button Grid.Column="1" Content="New schema" Command="{Binding NewDocumentCommand}" />
                <Button Grid.Column="2" Content="Open files" Command="{Binding OpenFilesCommand}" />
                <Button Grid.Column="3" Content="Save" Command="{Binding SaveDocumentCommand}" IsEnabled="{Binding HasSelectedDocument}" />
                <Button Grid.Column="4" Content="Save as…" Command="{Binding SaveDocumentAsCommand}" IsEnabled="{Binding HasSelectedDocument}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12,8" Background="#0E1828" BorderBrush="#25334A" BorderThickness="0,0,0,1">
            <ListBox ItemsSource="{Binding Documents}"
                     SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SchemaWorkspaceDocument">
                        <TextBlock Text="{Binding DisplayName}" Margin="12,7" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="280,*,320" ColumnSpacing="1" Background="#25334A">
            <Border Grid.Column="0" Padding="18" Background="#101A2A">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,16">
                        <TextBlock Text="SCHEMA TREE" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Foreground="#94A4BA" />
                        <TextBlock Text="{Binding SelectedDocument.Schema.Name}" FontSize="18" FontWeight="SemiBold" Foreground="#E7EEF8" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="Select a node to edit its name, type and documentation."
                               TextWrapping="Wrap" Margin="0,14,0,0" FontSize="11" Foreground="#7588A2" />
                <st:SchemaTreeControl EditDocument="{Binding SelectedDocument.Schema}"
                                      SelectedNode="{Binding SelectedNode, Mode=TwoWay}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Padding="24" Background="#0B1220">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="NODE EDITOR" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Foreground="#94A4BA" />
                        <TextBlock Text="Shape your message structure" FontSize="22" FontWeight="SemiBold" Foreground="#E7EEF8" />
                    </StackPanel>
                    <Border Grid.Row="1" Padding="12" Margin="0,18,0,0" CornerRadius="6" Background="#142238">
                        <TextBlock Text="New schemas start with a SysEx group. Add fields directly to define the message structure."
                                   TextWrapping="Wrap" Foreground="#B7C5D8" FontSize="12" />
                    </Border>
                    <StackPanel Grid.Row="2" Spacing="12" Margin="0,22,0,0">
                        <TextBlock Text="Selected node properties" FontSize="13" FontWeight="SemiBold" Foreground="#DCE6F3" />
                        <TextBox PlaceholderText="Node name" Text="{Binding NodeName}" />
                        <ComboBox ItemsSource="{Binding DataTypeOptions}" IsEditable="True" Text="{Binding NodeDataType}" />
                        <TextBox PlaceholderText="Description"
                                 Text="{Binding NodeDescription}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="66" />
                        <TextBox PlaceholderText="Sample value" Text="{Binding NodeSampleValue}" />
                        <Button Content="Apply node changes" HorizontalAlignment="Left" Command="{Binding ApplyNodeEditsCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="3"
                               Text="Choose a group or field in the schema tree to inspect and edit it."
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="#7588A2" />
                    <TextBlock Grid.Row="4" Text="{Binding SelectedDocument.FileName}" FontSize="11" Foreground="#7588A2" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="18" Background="#101A2A">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="ADD A FIELD" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Foreground="#94A4BA" />
                        <TextBlock Text="Build the schema or capture bytes" FontSize="16" FontWeight="SemiBold" Foreground="#E7EEF8" />
                    </StackPanel>
                        <TextBox PlaceholderText="Group name" Text="{Binding NewGroupName}" />
                        <Button Content="Add nested group" Command="{Binding AddGroupCommand}" />
                        <Border Height="1" Background="#25334A" Margin="0,4" />
                        <TextBox PlaceholderText="Field name" Text="{Binding NewFieldName}" />
                    <ComboBox ItemsSource="{Binding DataTypeOptions}" IsEditable="True" Text="{Binding NewFieldDataType}" />
                    <TextBox PlaceholderText="Sample value (optional)" Text="{Binding NewFieldSampleValue}" />
                    <Button Content="Add field to selected group" Command="{Binding AddFieldCommand}" />
                    <Border Height="1" Background="#25334A" Margin="0,4" />
                    <TextBlock Text="Descriptions and sample values are stored as schema properties so they stay with the file."
                               TextWrapping="Wrap" FontSize="11" Foreground="#94A4BA" />
                    <TextBlock Text="Supported files: .json · .xml · .yaml · .yml"
                               TextWrapping="Wrap" FontSize="11" Foreground="#94A4BA" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="16,8" Background="#111B2C">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#B7C5D8" />
        </Border>
    </Grid>
</UserControl>
