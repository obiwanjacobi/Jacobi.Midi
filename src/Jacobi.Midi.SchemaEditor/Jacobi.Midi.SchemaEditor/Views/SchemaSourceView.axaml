<!--
    The schema source viewer: the serialized schema of a document, read-only, with syntax coloring and folding,
    as XML or JSON (the tabs). See SchemaSourceViewModel.
    Hosted in a SchemaSourceWindow (Desktop) or in an overlay of the MainView (Browser).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jacobi.Midi.SchemaEditor.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Jacobi.Midi.SchemaEditor.Views.SchemaSourceView"
             x:DataType="vm:SchemaSourceViewModel">

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Margin="0,0,0,12">
            <StackPanel Spacing="4">
                <TextBlock Text="SCHEMA SOURCE" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Foreground="{DynamicResource AppTextLabelBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextHeadingBrush}" />
            </StackPanel>
            <!-- the format tabs -->
            <TabStrip Grid.Column="1" Classes="switch" VerticalAlignment="Bottom"
                      ItemsSource="{Binding FormatNames}" SelectedIndex="{Binding SelectedIndex}" />
            <Button Grid.Column="2" Content="Close" VerticalAlignment="Top" IsCancel="True" Command="{Binding CloseCommand}" />
        </Grid>
        <ae:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True"
                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="13"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                       Foreground="{DynamicResource AppTextBodyBrush}" />
    </DockPanel>
</UserControl>
