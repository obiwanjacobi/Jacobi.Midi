<!--
    The details of the processor namespace selected in the assembly tree: the processors of its factory.
    Shown in place of the node editor. Read-only. The data context is the ProcessorNamespaceItem.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asm="using:Jacobi.Midi.SchemaEditor.Assemblies"
             x:Class="Jacobi.Midi.SchemaEditor.Assemblies.ProcessorNamespaceDetailsView"
             x:DataType="asm:ProcessorNamespaceItem">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextLabelBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="PROCESSOR NAMESPACE" Classes="label" />
                <TextBlock Text="{Binding Namespace}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppTextHeadingBrush}" />
                <TextBlock Text="{Binding Summary}" Classes="muted" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasProcessors}">
                <TextBlock Text="PROCESSORS" Classes="label" />
                <!-- one card per processor: key, stage, descriptive name and the properties it publishes -->
                <ItemsControl ItemsSource="{Binding ProcessorInfos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="asm:ProcessorInfo">
                            <Border Padding="10" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource AppBackgroundCardBrush}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <SelectableTextBlock Text="{Binding Key}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBodyBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding StageText}" Classes="muted" VerticalAlignment="Center"
                                                   ToolTip.Tip="The pipeline stage the processor operates in" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" Classes="muted" />
                                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextAccentBrush}"
                                               IsVisible="{Binding HasProblem}" />
                                    <TextBlock Text="No published properties." Classes="muted" FontStyle="Italic" IsVisible="{Binding HasNoProperties}" />
                                    <ItemsControl ItemsSource="{Binding Properties}" IsVisible="{Binding HasProperties}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="asm:ProcessorPropertyInfo">
                                                <StackPanel Spacing="2" Margin="0,4,0,0">
                                                    <Grid ColumnDefinitions="160,*" ColumnSpacing="8">
                                                        <SelectableTextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBodyBrush}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding DataType}" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Flags}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasFlags}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="168,0,0,0"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding HasDescription}" />
                                                    <TextBlock Text="{Binding Values}" TextWrapping="Wrap" Margin="168,0,0,0" Classes="muted"
                                                               IsVisible="{Binding HasValues}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
