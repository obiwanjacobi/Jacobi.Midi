<!--
    The value reference finder: shown as an overlay (so it works in the Desktop and the Browser host)
    to choose the reference of a value-or-reference property: a field before the node (ref:) or a published value (pub:).
    See ValueRefFinderViewModel.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ne="using:Jacobi.Midi.SchemaEditor.NodeEditor"
             xmlns:models="using:Jacobi.Midi.SchemaEditor.Models"
             x:Class="Jacobi.Midi.SchemaEditor.NodeEditor.ValueRefFinderView"
             x:DataType="ne:ValueRefFinderViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.path">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextLabelBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <Grid Background="#99000000">
        <Border MaxWidth="820" MaxHeight="720" Margin="32" Padding="20" CornerRadius="8"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Background="{DynamicResource AppBackgroundPanelBrush}"
                BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
                    <TextBlock Text="FIND REFERENCE" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Foreground="{DynamicResource AppTextLabelBrush}" />
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource AppTextHeadingBrush}" />
                </StackPanel>
                <!-- what the user may not expect, e.g. the schema did not compile -->
                <Border DockPanel.Dock="Top" IsVisible="{Binding HasNotes}" Margin="0,0,0,12" Padding="8" CornerRadius="4"
                        BorderBrush="Orange" BorderThickness="1">
                    <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextBodyBrush}" />
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,14,0,0">
                    <TextBlock Text="{Binding Problem}" Foreground="Orange" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <SelectableTextBlock Text="{Binding Result}" FontFamily="Consolas,Menlo,monospace" FontSize="12" VerticalAlignment="Center"
                                             TextWrapping="Wrap" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                            <Button Content="Apply" Classes="accent" Command="{Binding ApplyCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TabControl SelectedIndex="{Binding SelectedTab}">
                    <!-- the fields before the node, nearest first, with an instance index per repeat on the path of the selected one -->
                    <TabItem Header="ref: field">
                        <DockPanel Margin="0,10,0,0">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,8">
                                <TextBox Text="{Binding Filter}" PlaceholderText="Filter on path" />
                                <CheckBox Grid.Column="1" Content="Relative path (^)" IsChecked="{Binding IsRelative}"
                                          ToolTip.Tip="'^' per level up from this node, then down to the field: the reference keeps working where the node is reused (e.g. a node def). It keeps the item of this node in the repeats it goes up through and cannot reach into another repeat." />
                            </Grid>
                            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0" IsVisible="{Binding ShowsRepeatIndexes}">
                                <TextBlock Text="Repeat items: empty is [] (the same item as this node), a number is that item" Classes="note" />
                                <ItemsControl ItemsSource="{Binding RepeatIndexes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ne:RepeatIndexBox">
                                            <Grid ColumnDefinitions="*,140" ColumnSpacing="8" Margin="0,2">
                                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ComboBox Grid.Column="1" Classes="options" IsEditable="True" Text="{Binding Text}"
                                                          ItemsSource="{Binding Options}" PlaceholderText="{Binding Placeholder}" HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="No fields before this node can be referenced." Classes="note" IsVisible="{Binding HasNoTargets}" />
                            <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" MinHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ValueRefTarget">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DataType}" Classes="path" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <!-- the values the processors before the node publish -->
                    <TabItem Header="pub: published value">
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="No processor before this node publishes a value." Classes="note" IsVisible="{Binding HasNoPublished}" />
                            <ListBox ItemsSource="{Binding Published}" SelectedItem="{Binding SelectedPublished}" MinHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ValueRefPublished">
                                        <StackPanel ToolTip.Tip="{Binding Description}">
                                            <TextBlock Text="{Binding Reference}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="path">
                                                <Run Text="{Binding DataType}" />
                                                <Run Text=" — by " />
                                                <Run Text="{Binding Source}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
