<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jacobi.Midi.SchemaEditor.ViewModels"
             xmlns:models="using:Jacobi.Midi.SchemaEditor.Models"
             xmlns:ne="using:Jacobi.Midi.SchemaEditor.NodeEditor"
             xmlns:schema="using:Jacobi.BinarySerializer.Schema"
             x:Class="Jacobi.Midi.SchemaEditor.NodeEditor.NodeEditorControl"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextCaptionBrush}" />
        </Style>
        <Style Selector="TextBlock.kind">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextLabelBrush}" />
        </Style>
        <Style Selector="TextBox.description">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="66" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- one effective property (a keyed resource: the General tab editor templates would otherwise shadow it with their fallback); own properties are editable, inherited ones can be overridden -->
        <DataTemplate x:Key="PropertyRowTemplate" x:DataType="ne:PropertyRow">
            <Grid ColumnDefinitions="160,*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding IsOwn}" />
                <TextBlock Text="{Binding Name}" IsVisible="{Binding IsInherited}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="(no value)" IsVisible="{Binding IsOwn}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding IsInherited}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="kind" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="Remove" IsVisible="{Binding IsOwn}" CommandParameter="{Binding}"
                        Command="{Binding Details.RemovePropertyCommand}" />
                <Button Grid.Column="3" Content="Override" IsVisible="{Binding CanOverride}" CommandParameter="{Binding}"
                        Command="{Binding Details.OverridePropertyCommand}" />
            </Grid>
        </DataTemplate>

        <!-- the processors and properties of an item (the document, a data type def): add buttons and the effective entries -->
        <DataTemplate x:Key="DetailsSectionsTemplate" x:DataType="ne:ItemDetailsViewModel">
            <StackPanel Spacing="10">
                <ItemsControl ItemsSource="{Binding Unresolved}" IsVisible="{Binding HasUnresolved}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextAccentBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="6" IsVisible="{Binding HasProcessors}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="PROCESSORS" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" VerticalAlignment="Center" Foreground="{DynamicResource AppTextLabelBrush}" />
                        <Button Grid.Column="1" Content="Add processor" Command="{Binding AddProcessorCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Processors}" />
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding HasPropertiesTab}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="PROPERTIES" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" VerticalAlignment="Center" Foreground="{DynamicResource AppTextLabelBrush}" />
                        <Button Grid.Column="1" Content="Add property" Command="{Binding AddPropertyCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Properties}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- a document collection tab: the list of its items with add and remove, and the editor of the selected item -->
        <DataTemplate x:Key="CollectionTabTemplate" x:DataType="ne:CollectionTabViewModel">
            <Grid ColumnDefinitions="260,*" ColumnSpacing="16" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Add" Command="{Binding AddCommand}" />
                        <Button Content="Remove" Command="{Binding RemoveCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedEntry}" />
                </DockPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding Editor}" Margin="0,0,12,0" />
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <!-- the Processors and Properties tab bodies of a node (or node def) -->
        <DataTemplate x:Key="ProcessorsPanelTemplate" x:DataType="ne:ItemDetailsViewModel">
            <StackPanel Spacing="10">
                <ItemsControl ItemsSource="{Binding Unresolved}" IsVisible="{Binding HasUnresolved}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextAccentBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="PROCESSORS" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" VerticalAlignment="Center" Foreground="{DynamicResource AppTextLabelBrush}" />
                    <Button Grid.Column="1" Content="Add processor" Command="{Binding AddProcessorCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Processors}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PropertiesPanelTemplate" x:DataType="ne:ItemDetailsViewModel">
            <StackPanel Spacing="10">
                <ItemsControl ItemsSource="{Binding Unresolved}" IsVisible="{Binding HasUnresolved}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppTextAccentBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="EFFECTIVE PROPERTIES" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" VerticalAlignment="Center" Foreground="{DynamicResource AppTextLabelBrush}" />
                    <Button Grid.Column="1" Content="Add property" Command="{Binding AddPropertyCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Properties}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <!-- one effective processor with its effective properties; only own processors are editable -->
        <DataTemplate x:DataType="ne:ProcessorRow">
            <Border Padding="10" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource AppBackgroundCardBrush}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,140,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding Processor, UpdateSourceTrigger=LostFocus}" PlaceholderText="namespace.id or ref:name" IsVisible="{Binding IsOwn}" />
                        <TextBlock Text="{Binding Processor}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding IsInherited}" />
                        <TextBox Grid.Column="1" Text="{Binding PublishNamespace, UpdateSourceTrigger=LostFocus}" PlaceholderText="publish namespace" IsVisible="{Binding IsOwn}" />
                        <TextBlock Grid.Column="1" Text="{Binding PublishNamespace}" Classes="kind" VerticalAlignment="Center" IsVisible="{Binding IsInherited}" />
                        <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="kind" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="Remove" IsVisible="{Binding IsOwn}" CommandParameter="{Binding}"
                                Command="{Binding Details.RemoveProcessorCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Properties}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
                    <Button Content="Add property" HorizontalAlignment="Left" IsVisible="{Binding IsOwn}" CommandParameter="{Binding}"
                            Command="{Binding Details.AddProcessorPropertyCommand}" />
                </StackPanel>
            </Border>
        </DataTemplate>
                <!-- most specific types first: the first matching template wins -->
                <DataTemplate x:DataType="models:EditDocument">
                    <StackPanel Spacing="12" x:DataType="vm:MainViewModel"
                                DataContext="{Binding $parent[ne:NodeEditorControl].DataContext}">
                        <TextBlock Text="Selected document properties" Classes="caption" />
                        <TextBlock Text="Renaming asks for confirmation: other documents may include this one by name." Classes="kind" />
                        <TextBox PlaceholderText="Document name" Text="{Binding DocumentName}" />
                        <Button Content="Rename…" HorizontalAlignment="Left" Command="{Binding RenameDocumentCommand}" />
                        <ContentControl Content="{Binding ItemDetails}" ContentTemplate="{StaticResource DetailsSectionsTemplate}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="models:EditRepeat">
                    <StackPanel Spacing="12" x:DataType="vm:MainViewModel"
                                DataContext="{Binding $parent[ne:NodeEditorControl].DataContext}">
                        <TextBlock Text="Selected repeat properties" Classes="caption" />
                        <TextBlock Text="Repeats its members a number of times." Classes="kind" />
                        <TextBox PlaceholderText="Repeat name" Text="{Binding NodeName}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Node def" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.NodeDef}" PlaceholderText="optional, e.g. name or schema.name" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Count" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.Count}" PlaceholderText="number, ref:path or pub:ns.name" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Byte size" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.ByteSize}" PlaceholderText="optional: number, ref:path or pub:ns.name" />
                        </StackPanel>
                        <TextBox PlaceholderText="Description" Text="{Binding NodeDescription}" Classes="description" />
                        <Button Content="Apply repeat changes" HorizontalAlignment="Left" Command="{Binding ApplyNodeEditsCommand}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="models:EditChoice">
                    <StackPanel Spacing="12" x:DataType="vm:MainViewModel"
                                DataContext="{Binding $parent[ne:NodeEditorControl].DataContext}">
                        <TextBlock Text="Selected choice properties" Classes="caption" />
                        <TextBlock Text="Selects one of its members at runtime." Classes="kind" />
                        <TextBox PlaceholderText="Choice name" Text="{Binding NodeName}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Node def" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.NodeDef}" PlaceholderText="optional, e.g. name or schema.name" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Selected index" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.SelectedIndex}" PlaceholderText="number, ref:path or pub:ns.name" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Member node def" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.MemberNodeDef}" PlaceholderText="optional: makes the choice open" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Pipeline" Classes="label" />
                            <ComboBox ItemsSource="{Binding PipelineOptions}" SelectedItem="{Binding NodeFacets.Pipeline}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Byte size" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.ByteSize}" PlaceholderText="optional: number, ref:path or pub:ns.name" />
                        </StackPanel>
                        <TextBox PlaceholderText="Description" Text="{Binding NodeDescription}" Classes="description" />
                        <Button Content="Apply choice changes" HorizontalAlignment="Left" Command="{Binding ApplyNodeEditsCommand}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="models:EditGroup">
                    <StackPanel Spacing="12" x:DataType="vm:MainViewModel"
                                DataContext="{Binding $parent[ne:NodeEditorControl].DataContext}">
                        <TextBlock Text="Selected group properties" Classes="caption" />
                        <TextBlock Text="Groups a sequence of fields and nested nodes." Classes="kind" />
                        <TextBox PlaceholderText="Group name" Text="{Binding NodeName}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Node def" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.NodeDef}" PlaceholderText="optional, e.g. name or schema.name" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Byte size" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.ByteSize}" PlaceholderText="optional: number, ref:path or pub:ns.name" />
                        </StackPanel>
                        <TextBox PlaceholderText="Description" Text="{Binding NodeDescription}" Classes="description" />
                        <Button Content="Apply group changes" HorizontalAlignment="Left" Command="{Binding ApplyNodeEditsCommand}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="models:EditField">
                    <StackPanel Spacing="12" x:DataType="vm:MainViewModel"
                                DataContext="{Binding $parent[ne:NodeEditorControl].DataContext}">
                        <TextBlock Text="Selected field properties" Classes="caption" />
                        <TextBox PlaceholderText="Field name" Text="{Binding NodeName}" />
                        <ComboBox ItemsSource="{Binding DataTypeOptions}" IsEditable="True" Text="{Binding NodeDataType}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Node def" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.NodeDef}" PlaceholderText="optional, e.g. name or schema.name" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Value" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.Value}" PlaceholderText="optional constant, ref:path or pub:ns.name" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Byte length" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.ByteLength}" PlaceholderText="optional: number, ref:path or pub:ns.name" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Byte offset" Classes="label" />
                            <TextBox Text="{Binding NodeFacets.ByteOffset}" PlaceholderText="optional signed number" />
                        </StackPanel>
                        <TextBox PlaceholderText="Description" Text="{Binding NodeDescription}" Classes="description" />
                        <TextBox PlaceholderText="Sample value" Text="{Binding NodeSampleValue}" />
                        <Button Content="Apply field changes" HorizontalAlignment="Left" Command="{Binding ApplyNodeEditsCommand}" />
                    </StackPanel>
                </DataTemplate>

        <!-- items of the document collection lists -->
        <DataTemplate x:DataType="models:EditDocumentRef">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Schema}" Foreground="{DynamicResource AppTextBodyBrush}" />
                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource AppTextMutedBrush}" />
                <TextBlock Text="!" FontWeight="Bold" Foreground="Orange" IsVisible="{Binding IsNotLoaded}"
                           ToolTip.Tip="The included document is not loaded." />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:DataType="models:EditDataTypeDef">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                <TextBlock Text="{Binding BasedOn}" Foreground="{DynamicResource AppTextMutedBrush}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:DataType="models:EditProcessorDef">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                <TextBlock Text="{Binding Processor}" Foreground="{DynamicResource AppTextMutedBrush}" />
            </StackPanel>
        </DataTemplate>

                <!-- item editors of the document collections (live editing) -->
                <DataTemplate x:DataType="ne:DocumentRefEditor">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Include" Classes="caption" />
                        <TextBlock Text="Includes another schema so its definitions can be referenced as 'schema.name'." Classes="kind" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Schema" Classes="label" />
                            <TextBox Text="{Binding Schema}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Path" Classes="label" />
                            <TextBox Text="{Binding Path}" PlaceholderText="optional" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="ne:DataTypeDefEditor">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Data type def" Classes="caption" />
                        <TextBlock Text="A named data type based on another type, with optional facets and options." Classes="kind" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Name" Classes="label" />
                            <TextBox Text="{Binding Name}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Based on" Classes="label" />
                            <TextBox Text="{Binding BasedOn}" PlaceholderText="e.g. sys.uint8" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Min" Classes="label" />
                                <TextBox Text="{Binding Min}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Max" Classes="label" />
                                <TextBox Text="{Binding Max}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Scale" Classes="label" />
                                <TextBox Text="{Binding Scale}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Text="Shift" Classes="label" />
                                <TextBox Text="{Binding Shift}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="OPTIONS" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" VerticalAlignment="Center" Foreground="{DynamicResource AppTextLabelBrush}" />
                            <Button Grid.Column="1" Content="Add option" Command="{Binding AddOptionCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ne:OptionRow">
                                    <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="8" Margin="0,2">
                                        <TextBox Text="{Binding Value}" PlaceholderText="value" />
                                        <TextBox Grid.Column="1" Text="{Binding Label}" PlaceholderText="label" />
                                        <Button Grid.Column="2" Content="Remove" CommandParameter="{Binding}"
                                                Command="{Binding $parent[ItemsControl].((ne:DataTypeDefEditor)DataContext).RemoveOptionCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ContentControl Content="{Binding Details}" ContentTemplate="{StaticResource DetailsSectionsTemplate}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="ne:ProcessorDefEditor">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Processor def" Classes="caption" />
                        <TextBlock Text="A processor with default properties, referenced as 'ref:name'." Classes="kind" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Name" Classes="label" />
                            <TextBox Text="{Binding Name}" />
                        </StackPanel>
                        <TextBlock Text="The processor it references, with its properties." Classes="label" />
                        <ContentControl Content="{Binding Details.Definition}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="ne:ProcessorDefRow">
    <Border Padding="10" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource AppBackgroundCardBrush}">
        <StackPanel Spacing="6">
            <TextBox Text="{Binding Processor, UpdateSourceTrigger=LostFocus}" PlaceholderText="namespace.id" />
            <ItemsControl ItemsSource="{Binding Properties}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
            <Button Content="Add property" HorizontalAlignment="Left"
                    Command="{Binding Details.AddPropertyCommand}" />
        </StackPanel>
    </Border>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="4">
                <TextBlock Text="NODE EDITOR" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Foreground="{DynamicResource AppTextLabelBrush}" />
                <TextBlock Text="{Binding SelectedItemPath}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppTextHeadingBrush}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Add ▾" IsEnabled="{Binding CanAdd}"
                    ToolTip.Tip="Add a node to the selected group, or a processor or property to the selected item">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Field" Command="{Binding AddNodeCommand}" CommandParameter="{x:Static schema:SchemaNodeKind.Field}" IsVisible="{Binding CanAddMembers}" />
                        <MenuItem Header="Group" Command="{Binding AddNodeCommand}" CommandParameter="{x:Static schema:SchemaNodeKind.Group}" IsVisible="{Binding CanAddMembers}" />
                        <MenuItem Header="Repeat" Command="{Binding AddNodeCommand}" CommandParameter="{x:Static schema:SchemaNodeKind.Repeat}" IsVisible="{Binding CanAddMembers}" />
                        <MenuItem Header="Choice" Command="{Binding AddNodeCommand}" CommandParameter="{x:Static schema:SchemaNodeKind.Choice}" IsVisible="{Binding CanAddMembers}" />
                        <Separator IsVisible="{Binding ShowItemEntriesSeparator}" />
                        <MenuItem Header="Processor (selected item)" Command="{Binding AddItemProcessorCommand}" IsVisible="{Binding CanAddItemProcessor}" />
                        <MenuItem Header="Property (selected item)" Command="{Binding AddItemPropertyCommand}" IsVisible="{Binding CanAddItemProperty}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Delete" Command="{Binding DeleteItemCommand}"
                    ToolTip.Tip="Delete the selected item" />
        </Grid>

        <TabControl Grid.Row="2" Margin="0,14,0,0" SelectedIndex="{Binding SelectedEditorTab}"
                    IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TabItem Header="General">
                <!-- The selected node or item editor picks its template by type. The node template roots rebind their
                     DataContext to the MainViewModel so the editors bind to its staged node values. -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ContentControl Margin="0,12,12,0" Content="{Binding GeneralEditor}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Processors" IsVisible="{Binding ItemDetails.ShowProcessorsTab, FallbackValue=False}">
                <ScrollViewer>
                    <ContentControl Content="{Binding ItemDetails}" ContentTemplate="{StaticResource ProcessorsPanelTemplate}" Margin="0,12,12,0" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Properties" IsVisible="{Binding ItemDetails.ShowPropertiesTab, FallbackValue=False}">
                <ScrollViewer>
                    <ContentControl Content="{Binding ItemDetails}" ContentTemplate="{StaticResource PropertiesPanelTemplate}" Margin="0,12,12,0" />
                </ScrollViewer>
            </TabItem>

            <!-- the document collections: shown when the document root is selected -->
            <TabItem Header="Includes" IsVisible="{Binding IsDocumentSelected}">
                <ContentControl Content="{Binding DocumentTabs.Includes}" ContentTemplate="{StaticResource CollectionTabTemplate}" />
            </TabItem>

            <TabItem Header="Node Defs" IsVisible="{Binding IsDocumentSelected}">
                <Grid ColumnDefinitions="300,*" ColumnSpacing="16" Margin="0,12,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Content="Add ▾" ToolTip.Tip="Add a node def and edit it">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Field" Command="{Binding AddNodeDefCommand}" CommandParameter="{x:Static schema:SchemaNodeKind.Field}" />
                                        <MenuItem Header="Group" Command="{Binding AddNodeDefCommand}" CommandParameter="{x:Static schema:SchemaNodeKind.Group}" />
                                        <MenuItem Header="Repeat" Command="{Binding AddNodeDefCommand}" CommandParameter="{x:Static schema:SchemaNodeKind.Repeat}" />
                                        <MenuItem Header="Choice" Command="{Binding AddNodeDefCommand}" CommandParameter="{x:Static schema:SchemaNodeKind.Choice}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Content="Delete" Command="{Binding DeleteItemCommand}" ToolTip.Tip="Delete the selected node def" />
                        </StackPanel>
                        <TreeView x:Name="NodeDefsTree" ItemsSource="{Binding SelectedDocument.Schema.NodeDefs}"
                                  SelectedItem="{Binding SelectedNodeDef, Mode=TwoWay}">
                            <TreeView.DataTemplates>
                                <TreeDataTemplate x:DataType="models:EditGroup" ItemsSource="{Binding Members}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    </StackPanel>
                                </TreeDataTemplate>
                                <DataTemplate x:DataType="models:EditField">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                                        <TextBlock Text="{Binding DataType}" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                    </DockPanel>
                    <TabControl Grid.Column="1" IsVisible="{Binding SelectedNodeDef, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TabItem Header="General">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ContentControl Margin="0,12,12,0" Content="{Binding SelectedNodeDef}" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Processors" IsVisible="{Binding SelectedNodeDefDetails.ShowProcessorsTab, FallbackValue=False}">
                            <ScrollViewer>
                                <ContentControl Content="{Binding SelectedNodeDefDetails}" ContentTemplate="{StaticResource ProcessorsPanelTemplate}" Margin="0,12,12,0" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Properties" IsVisible="{Binding SelectedNodeDefDetails.ShowPropertiesTab, FallbackValue=False}">
                            <ScrollViewer>
                                <ContentControl Content="{Binding SelectedNodeDefDetails}" ContentTemplate="{StaticResource PropertiesPanelTemplate}" Margin="0,12,12,0" />
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    <TextBlock Grid.Column="1" Text="Select a node def to edit it."
                               IsVisible="{Binding SelectedNodeDef, Converter={x:Static ObjectConverters.IsNull}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" />
                </Grid>
            </TabItem>

            <TabItem Header="Data Type Defs" IsVisible="{Binding IsDocumentSelected}">
                <ContentControl Content="{Binding DocumentTabs.DataTypeDefs}" ContentTemplate="{StaticResource CollectionTabTemplate}" />
            </TabItem>

            <TabItem Header="Processor Defs" IsVisible="{Binding IsDocumentSelected}">
                <ContentControl Content="{Binding DocumentTabs.ProcessorDefs}" ContentTemplate="{StaticResource CollectionTabTemplate}" />
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Text="Choose an item in the schema tree to inspect and edit it."
                   IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNull}}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AppTextMutedBrush}" />
        <TextBlock Grid.Row="3" Text="{Binding SelectedDocument.FileName}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" />
    </Grid>
</UserControl>
