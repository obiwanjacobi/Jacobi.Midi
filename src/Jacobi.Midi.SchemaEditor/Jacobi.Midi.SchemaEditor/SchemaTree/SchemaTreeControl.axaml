<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="using:Jacobi.Midi.SchemaEditor.SchemaTree"
             xmlns:models="using:Jacobi.Midi.SchemaEditor.Models"
             xmlns:schema="using:Jacobi.BinarySerializer.Schema"
             x:Class="Jacobi.Midi.SchemaEditor.SchemaTree.SchemaTreeControl">

    <DockPanel x:Name="Root" x:DataType="st:SchemaTreeViewModel">
        <TreeView x:Name="Tree"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <TreeView.DataTemplates>
                <TreeDataTemplate x:DataType="st:SchemaTreeRoot" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                        <TextBlock Text="{Binding Document.Name}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="document" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </TreeDataTemplate>
                <!-- the fixed first child of a document: its node defs -->
                <TreeDataTemplate x:DataType="st:NodeDefsItem" ItemsSource="{Binding Document.NodeDefs}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5" Background="Transparent">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout FlyoutPresenterClasses="noScroll">
                                <MenuItem Header="Add Field def" Command="{Binding $parent[st:SchemaTreeControl].AddNodeDefCommand}"
                                          CommandParameter="{x:Static schema:SchemaNodeKind.Field}" />
                                <MenuItem Header="Add Group def" Command="{Binding $parent[st:SchemaTreeControl].AddNodeDefCommand}"
                                          CommandParameter="{x:Static schema:SchemaNodeKind.Group}" />
                                <MenuItem Header="Add Repeat def" Command="{Binding $parent[st:SchemaTreeControl].AddNodeDefCommand}"
                                          CommandParameter="{x:Static schema:SchemaNodeKind.Repeat}" />
                                <MenuItem Header="Add Choice def" Command="{Binding $parent[st:SchemaTreeControl].AddNodeDefCommand}"
                                          CommandParameter="{x:Static schema:SchemaNodeKind.Choice}" />
                            </MenuFlyout>
                        </StackPanel.ContextFlyout>
                        <TextBlock Text="Node Defs" FontStyle="Italic" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding Document.NodeDefs.Count}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </TreeDataTemplate>
                <!-- Matches Group, Repeat and Choice. Add a more specific template above this one to style a kind differently. -->
                <TreeDataTemplate x:DataType="models:EditGroup" ItemsSource="{Binding Members}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5" Background="Transparent">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout FlyoutPresenterClasses="noScroll">
                                <MenuItem Header="Instantiate…" ToolTip.Tip="Provide values for this group"
                                          Command="{Binding $parent[st:SchemaTreeControl].InstantiateCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Match…" ToolTip.Tip="Read a SysEx file or received message into the values of this group"
                                          Command="{Binding $parent[st:SchemaTreeControl].MatchCommand}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Move up" InputGesture="Alt+Up" Command="{Binding $parent[st:SchemaTreeControl].MoveUpCommand}" />
                                <MenuItem Header="Move down" InputGesture="Alt+Down" Command="{Binding $parent[st:SchemaTreeControl].MoveDownCommand}" />
                                <MenuItem Header="Move into group above" InputGesture="Alt+Right" Command="{Binding $parent[st:SchemaTreeControl].IndentCommand}" />
                                <MenuItem Header="Move out of group" InputGesture="Alt+Left" Command="{Binding $parent[st:SchemaTreeControl].OutdentCommand}" />
                                <Separator />
                                <MenuItem Header="Change to Group" Command="{Binding $parent[st:SchemaTreeControl].ChangeKindCommand}"
                                          CommandParameter="{x:Static schema:SchemaNodeKind.Group}" />
                                <MenuItem Header="Change to Repeat" Command="{Binding $parent[st:SchemaTreeControl].ChangeKindCommand}"
                                          CommandParameter="{x:Static schema:SchemaNodeKind.Repeat}" />
                                <MenuItem Header="Change to Choice" Command="{Binding $parent[st:SchemaTreeControl].ChangeKindCommand}"
                                          CommandParameter="{x:Static schema:SchemaNodeKind.Choice}" />
                            </MenuFlyout>
                        </StackPanel.ContextFlyout>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </TreeDataTemplate>
                <DataTemplate x:DataType="models:EditField">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5" Background="Transparent">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout FlyoutPresenterClasses="noScroll">
                                <MenuItem Header="Move up" InputGesture="Alt+Up" Command="{Binding $parent[st:SchemaTreeControl].MoveUpCommand}" />
                                <MenuItem Header="Move down" InputGesture="Alt+Down" Command="{Binding $parent[st:SchemaTreeControl].MoveDownCommand}" />
                                <MenuItem Header="Move into group above" InputGesture="Alt+Right" Command="{Binding $parent[st:SchemaTreeControl].IndentCommand}" />
                                <MenuItem Header="Move out of group" InputGesture="Alt+Left" Command="{Binding $parent[st:SchemaTreeControl].OutdentCommand}" />
                            </MenuFlyout>
                        </StackPanel.ContextFlyout>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding DataType}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.DataTemplates>
        </TreeView>
    </DockPanel>
</UserControl>
