<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="using:Jacobi.Midi.SchemaEditor.SchemaTree"
             xmlns:models="using:Jacobi.Midi.SchemaEditor.Models"
             x:Class="Jacobi.Midi.SchemaEditor.SchemaTree.SchemaTreeControl">

    <UserControl.Styles>
        <Style Selector="RadioButton.view">
            <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel x:Name="Root" x:DataType="st:SchemaTreeViewModel">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
            <RadioButton Classes="view" GroupName="SchemaTreeView" Content="Document" IsChecked="{Binding IsDocumentView}" />
            <RadioButton Classes="view" GroupName="SchemaTreeView" Content="Members" IsChecked="{Binding IsMembersView}" />
        </StackPanel>

        <TreeView x:Name="Tree"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <TreeView.DataTemplates>
                <TreeDataTemplate x:DataType="st:SchemaTreeCategory" ItemsSource="{Binding Items}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextLabelBrush}" />
                        <TextBlock Text="{Binding Items.Count}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </TreeDataTemplate>
                <!-- Matches Group, Repeat and Choice. Add a more specific template above this one to style a kind differently. -->
                <TreeDataTemplate x:DataType="models:EditGroup" ItemsSource="{Binding Members}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </TreeDataTemplate>
                <DataTemplate x:DataType="models:EditField">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding DataType}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="models:EditDocumentRef">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                        <TextBlock Text="{Binding Schema}" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource AppTextMutedBrush}" />
                        <TextBlock Text="!" FontWeight="Bold" Foreground="Orange" IsVisible="{Binding IsNotLoaded}"
                                   ToolTip.Tip="The included document is not loaded." />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="models:EditDataTypeDef">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding BasedOn}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="models:EditProcessorDef">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding Processor}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="models:EditProcessorRef">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                        <TextBlock Text="{Binding Processor}" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding PublishNamespace}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="models:EditProperty">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextBodyBrush}" />
                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource AppTextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.DataTemplates>
        </TreeView>
    </DockPanel>
</UserControl>
