<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Jacobi.Midi.SchemaEditor"
             xmlns:models="using:Jacobi.Midi.SchemaEditor.Models"
             xmlns:themes="using:Jacobi.Midi.SchemaEditor.Themes"
             x:Class="Jacobi.Midi.SchemaEditor.App"
             RequestedThemeVariant="{x:Static themes:AppThemeVariants.Night}">

    <Application.DataTemplates>
        <local:ViewLocator />
        <!-- a data type in the data type drop-down lists: its name and, muted, what it is -->
        <DataTemplate x:DataType="models:DataTypeOption">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource AppTextMutedBrush}" />
            </StackPanel>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Jacobi.Midi.SchemaEditor/Themes/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <StyleInclude Source="avares://Jacobi.Midi.SchemaEditor/Themes/FluentTheme.axaml" />
    </Application.Styles>
</Application>
